    SU_LOGDIR=""; for d in /var/log/suricata /usr/local/var/log/suricata; do [ -d "$d" ] && { SU_LOGDIR="$d"; break; }; done
  fi
  SU_RULEDIR=$(yaml_val default-rule-path); SU_RULEDIR="${SU_RULEDIR%/}"
  if [ -z "$SU_RULEDIR" ] || [ ! -d "$SU_RULEDIR" ]; then
    SU_RULEDIR=""; for d in /var/lib/suricata/rules /usr/local/var/lib/suricata/rules /etc/suricata/rules /usr/local/etc/suricata/rules; do [ -d "$d" ] && { SU_RULEDIR="$d"; break; }; done
  fi
  c=$(sed -nE '/^unix-command:/,/^[a-z]/s/^[[:space:]]*#?[[:space:]]*filename:[[:space:]]*([^#[:space:]]+).*/\1/p' "$SU_YAML" 2>/dev/null | head -1); c="${c:-suricata-command.socket}"
  SU_SOCK=""; for d in /run/suricata /var/run/suricata /usr/local/var/run/suricata; do [ -S "$d/$c" ] && { SU_SOCK="$d/$c"; break; }; done
