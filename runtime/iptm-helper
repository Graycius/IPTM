# Read-only preflight. Never infer disabled IPv6 from a failing ip6tables
# command: only explicit sysctls are proof. Ignore loopback, but require
# global/default AND every non-loopback interface to be disabled.
ip6_gateway_disabled() {
  local dir="${1:-/proc/sys/net/ipv6/conf}" f iface value
  # An explicit kernel-wide IPv6 disable may remove the sysctl tree entirely.
  # Only trust this alternate signal for the REAL proc tree, never for fixtures.
  if [ "$dir" = /proc/sys/net/ipv6/conf ]; then
    if { [ -r /sys/module/ipv6/parameters/disable ] &&
         [ "$(cat /sys/module/ipv6/parameters/disable 2>/dev/null)" = 1 ]; } ||
       { grep -Eq '(^|[[:space:]])ipv6\.disable=1([[:space:]]|$)' /proc/cmdline 2>/dev/null; }; then
      [ ! -s /proc/net/if_inet6 ] && return 0
      return 1
    fi
  fi
  [ -r "$dir/all/disable_ipv6" ] && [ -r "$dir/default/disable_ipv6" ] || return 1
  [ "$(cat "$dir/all/disable_ipv6" 2>/dev/null)" = 1 ] || return 1
  [ "$(cat "$dir/default/disable_ipv6" 2>/dev/null)" = 1 ] || return 1
  for f in "$dir"/*/disable_ipv6; do
    [ -f "$f" ] || return 1
    iface="${f%/disable_ipv6}"; iface="${iface##*/}"
    case "$iface" in all|default|lo) continue ;; esac
    [ -r "$f" ] || return 1
    value=$(cat "$f" 2>/dev/null) || return 1
    [ "$value" = 1 ] || return 1
  done
  return 0
}
# Read-only diagnostics for an unavailable IPv6 legacy filter table.
ip6_backend_diagnostic() {
  local all=unknown default=unknown state=active_or_unknown backend=missing table=unavailable
  [ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ] && all=$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)
  [ -r /proc/sys/net/ipv6/conf/default/disable_ipv6 ] && default=$(cat /proc/sys/net/ipv6/conf/default/disable_ipv6 2>/dev/null)
  if ip6_gateway_disabled; then state=disabled; fi
  if command -v ip6tables >/dev/null 2>&1; then
    backend=$(timeout 3 ip6tables -V 2>/dev/null | head -c 120)
    [ -n "$backend" ] || backend=unknown
    if timeout 4 ip6tables -w -t filter -S >/dev/null 2>&1; then table=available; fi
  fi
  # The result is diagnostic metadata, never an authorization to skip IPv6.
  printf 'state=%s\nall=%s\ndefault=%s\nbackend=%s\nfilter=%s\n' \
    "$state" "$all" "$default" "$backend" "$table"
}
ip6_snapshot() {  # A successful exit from ip6tables-save is NOT enough: legacy can emit an empty snapshot.
  local snapshot rc detail=""
  if [ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ] &&
     [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" = 1 ]; then
    echo 'IPv6 disabilitato nel kernel: impossibile generare un rollback valido.' >&2
    return 72
  fi
  snapshot=$(ip6tables-save 2>&1); rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "ip6tables-save non riuscito (exit $rc): ${snapshot:0:360}" >&2
    return 73
  fi
  if ! printf '%s\n' "$snapshot" | grep -qxF '*filter'; then
    # Linux legacy backend sometimes loads filter only after a harmless query.
    if ip6tables -V 2>/dev/null | grep -qi legacy; then
      modprobe ip6table_filter >/dev/null 2>&1 || true
    fi
    ip6tables -w -t filter -S >/dev/null 2>&1 || true
    snapshot=$(ip6tables-save 2>&1); rc=$?
  fi
  if [ "$rc" -ne 0 ] ||
     ! printf '%s\n' "$snapshot" | grep -qxF '*filter' ||
     ! printf '%s\n' "$snapshot" | grep -qxF 'COMMIT'; then
    echo 'Snapshot IPv6 vuoto o incompleto: tabella filter non disponibile. Backup di rollback non creato; nessuna regola applicata. Verifica ip6tables -V, ip6tables -t filter -S, moduli kernel e IPv6 disabilitato.' >&2
    return 74
  fi
  printf '%s\n' "$snapshot"
}
# Keep the exact restore input for any legacy-filter retry. Re-reading the
# original stdin used to produce a misleading success on an empty second test.
ipt_restore_test() {
  local err rc tmp
  tmp=$(mktemp /tmp/iptm-v4-test.XXXXXXXX) || return 73
  if ! cat > "$tmp" || [ ! -s "$tmp" ] || [ "$(wc -c < "$tmp")" -gt 2097152 ]; then
    rm -f -- "$tmp"; echo 'Test IPv4: bozza assente, incompleta o troppo grande' >&2; return 2
  fi
  load_ipt_modules
  if err=$(iptables-restore --test < "$tmp" 2>&1); then
    rm -f -- "$tmp"; return 0
  else rc=$?; fi
  if iptables -V 2>/dev/null | grep -qi legacy && printf '%s' "$err" | grep -qi "unable to initialize table 'filter'"; then
    iptables -w -t filter -S >/dev/null 2>&1 || true
    load_ipt_modules
    if err=$(iptables-restore --test < "$tmp" 2>&1); then
      rm -f -- "$tmp"; return 0
    else rc=$?; fi
  fi
  rm -f -- "$tmp"
  printf '%s\n' "$err" >&2
  return "$rc"
}
ip6t_restore_test() {
  local err rc tmp
  tmp=$(mktemp /tmp/iptm-v6-test.XXXXXXXX) || return 73
  if ! cat > "$tmp" || [ ! -s "$tmp" ] || [ "$(wc -c < "$tmp")" -gt 2097152 ]; then
    rm -f -- "$tmp"; echo 'Test IPv6: bozza assente, incompleta o troppo grande' >&2; return 2
  fi
  load_ipt_modules
  if err=$(ip6tables-restore --test < "$tmp" 2>&1); then
    rm -f -- "$tmp"; return 0
  else rc=$?; fi
  if ip6tables -V 2>/dev/null | grep -qi legacy && printf '%s' "$err" | grep -qi "unable to initialize table 'filter'"; then
    ip6tables -w -t filter -S >/dev/null 2>&1 || true
    load_ipt_modules
    if err=$(ip6tables-restore --test < "$tmp" 2>&1); then
      rm -f -- "$tmp"; return 0
    else rc=$?; fi
  fi
  rm -f -- "$tmp"
  printf '%s\n' "$err" >&2
  if printf '%s' "$err" | grep -qEi 'line 1 failed|unable to initialize table'; then
    if ip6_gateway_disabled; then
      echo 'IPv6 disabilitato: nessun test ip6tables-restore possibile (nessuna modifica applicata).' >&2
    elif ! ip6tables -w -t filter -S >/dev/null 2>&1; then
      echo 'Tabella filter IPv6 non disponibile nel kernel/backend. Controlla ip6tables -V e i moduli ip6_tables/ip6table_filter; non cambiare backend alla cieca.' >&2
    else
      echo 'Tabella IPv6 filter leggibile, ma la bozza è stata rifiutata: controlla la sintassi effettiva, i moduli e il backend ip6tables.' >&2
    fi
  fi
  return "$rc"
}
