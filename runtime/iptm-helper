fw_heal() {   # auto|force: do not treat unreadable firewall snapshots as a healthy/empty kernel
  local mode="${1:-auto}" f n health4=0 health6=1 v6_disabled guard_dir
  guard_dir=$(data_dir) || return 1
  # Same stable lock as Apply/rollback. A mere pending.json check would race
  # the writer between observation and the first restore command.
  exec 8>"$guard_dir/apply.lock" || return 1
  if ! flock -x -w 3 8; then
    echo 'IPTM guard: Apply/rollback in corso; nessuna modifica al firewall' >&2
    return 0
  fi
  # Startup guard must not race a protected Apply/rollback transaction.
  # Refuse before changing any kernel rules; let the transaction watchdog recover.
  if [ -e "$guard_dir/pending.json" ]; then
    echo 'IPTM guard: transazione Apply pendente; nessun ripristino automatico (watchdog proprietario)' >&2
    return 0
  fi
  [ -s "$R4" ] || { echo "nessun file di regole salvato ($R4)"; return 2; }
  v6_disabled=$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo unknown)
  # IPv6 compiled out or disabled at boot: ip6tables-save may return success
  # with zero bytes. Do not interpret that as a damaged live IPv6 firewall.
  # Never skip the IPv6 check if the kernel still exposes an IPv6 interface.
  if [ ! -d /proc/sys/net/ipv6/conf ] && [ ! -e /proc/net/if_inet6 ]; then
    v6_disabled=1
  fi
  if [ "$mode" != force ]; then
    fw_unhealthy "$R4" iptables-save; health4=$?
    if [ "$health4" -eq 2 ]; then
      echo 'IPTM guard: lettura firewall IPv4 non attendibile; recovery sospeso' >&2
      return 1
    fi
    # Check IPv6 BEFORE touching IPv4: otherwise a failed IPv6 read may
    # leave a dual-stack system partly modified by an automatic recovery.
    if [ -s "$R6" ] && [ "$v6_disabled" != 1 ]; then
      command -v ip6tables-save >/dev/null || { echo 'IPTM guard: ip6tables-save non disponibile' >&2; return 1; }
      fw_unhealthy "$R6" ip6tables-save; health6=$?
      if [ "$health6" -eq 2 ]; then
        echo 'IPTM guard: lettura firewall IPv6 non attendibile; recovery sospeso' >&2
        return 1
      fi
    fi
  fi
  if [ "$mode" != force ] && [ "$health4" -eq 1 ]; then
    echo "ok: firewall IPv4 coerente con le regole salvate ($(iptables-save 2>/dev/null | grep -c '^-A ') regole, INPUT $(iptables -S INPUT 2>/dev/null | sed -n 's/^-P INPUT //p'))"
  else
    logger -t iptm-guard "firewall assente o ridotto rispetto a $R4: ripristino ($mode)" 2>/dev/null
    "$BASH" "$0" ipset-boot >/dev/null 2>&1
    if ! iptables-restore --test < "$R4" >/dev/null 2>&1; then
      echo 'IPTM guard: rules.v4 non ripristinabile (possibili IPSet dinamici assenti); stato live preservato' >&2
      return 1
    fi
    if iptables-restore < "$R4" 2>/dev/null; then echo "ripristinate le regole salvate ($R4)"; notify_send "firewall ripristinato dalle regole salvate" 2>/dev/null
    else
      n=""; for f in $(ls -1t "$(data_dir)"/backups/rules.v4.* /etc/iptables/rules.v4.bak-* 2>/dev/null); do
        iptables-restore --test < "$f" >/dev/null 2>&1 && iptables-restore < "$f" 2>/dev/null && { n="$f"; break; }; done
      if [ -n "$n" ]; then echo "regole salvate non valide: ripristinata la copia $n"; notify_send "firewall ripristinato dalla copia $n" 2>/dev/null
      else
        # A guessed RFC1918-only emergency policy may lock out SSH/LAN on
        # CGNAT, public, non-standard or VLAN management networks. Preserve
        # the live rules and require an explicit operator recovery instead.
        echo 'IPTM guard: nessuna copia valida; NON applico una policy di emergenza con reti presunte. Ripristino manuale richiesto.' >&2
        return 1
      fi
    fi
  fi
  # Disabling IPv6 at kernel level makes restoring old IPv6 rules meaningless.
  if [ -s "$R6" ] && [ "$v6_disabled" != 1 ]; then
    if ! command -v ip6tables-restore >/dev/null; then
      echo 'ripristino IPv6 non disponibile: ip6tables-restore assente' >&2; return 1
    elif [ "$mode" = force ] || [ "$health6" -eq 0 ]; then
      if ip6tables-restore < "$R6" 2>/dev/null; then echo 'ripristinate le regole IPv6'
      else echo 'ripristino IPv6 fallito (IPv4 può essere già stato ripristinato)' >&2; return 1; fi
    fi
  fi
  return 0
}
