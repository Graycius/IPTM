  # dpkg-query returns 1 when some requested packages are absent: that's NOT a failure.
  local pkg_known=1
  if { [ "$dpkg_rc" -ne 0 ] && [ "$dpkg_rc" -ne 1 ]; } || [ -z "$pkgdata" ]; then pkg_known=0; fi
  if [ "$pkg_known" -eq 1 ]; then
    while IFS=$'\t' read -r p val; do
      [ -n "$p" ] && [ "$val" = 'install ok installed' ] && inst["$p"]=1
    done <<<"$pkgdata"
  fi
  local apt_known=1
  if command -v apt-cache >/dev/null 2>&1; then
    aptdata=$(LC_ALL=C timeout -k 1s 8s apt-cache policy "${packages[@]}" 2>/dev/null)
    apt_rc=$?
    { [ "$apt_rc" -eq 0 ] && [ -n "$aptdata" ]; } || apt_known=0
    if [ "$apt_known" -eq 1 ]; then
      while IFS= read -r p; do [ -n "$p" ] && offered["$p"]=1; done < <(
        awk '/^[^[:space:]][^:]*:$/ {p=$1;sub(/:$/, "", p)} /^[[:space:]]+Candidate:/ {if ($2!="(none)") print p}' <<<"$aptdata")
    fi
  else apt_known=0; fi
  # One D-Bus call, rather than 20+ sequential systemctl calls.
  for n in "${names[@]}"; do
    for q in $(tool_svcs "$n"); do units+=("$q"); done
  done
  for n in "${names[@]}"; do units+=("iptm-tool-$n.service"); done
  svcdata=$(timeout -k 1s 4s systemctl is-active "${units[@]}" 2>/dev/null)
  svc_rc=$?
  local svc_known=1
  # is-active returns 3 if *any* unit is inactive: still yields one row per unit.
  mapfile -t unit_states <<<"$svcdata"
  [ "${#unit_states[@]}" -eq "${#units[@]}" ] || svc_known=0
  local i=0
  if [ "$svc_known" -eq 1 ]; then
    for q in "${units[@]}"; do active["$q"]="${unit_states[$i]}"; i=$((i+1)); done
  fi
  for n in "${names[@]}"; do
    st=absent
    if [ "$pkg_known" -eq 0 ]; then st=unknown; else
      case "$n" in
        fail2ban|suricata|vnstat|tcpdump|conntrack|psad|arpwatch|auditd|lynis|unbound)
          p="$n"; [ -n "${inst[$p]:-}" ] && st=installed ;;
        xtables) [ -n "${inst[xtables-addons-common]:-}" ] && st=installed ;;
        ipset) [ -n "${inst[ipset]:-}" ] && st=installed ;;
        clamav) if [ -n "${inst[clamav]:-}" ] && [ -n "${inst[clamav-freshclam]:-}" ]; then st=installed; elif [ -n "${inst[clamav]:-}" ]; then st=partial; fi ;;
        clamavd) [ -n "${inst[clamav-daemon]:-}" ] && st=installed ;;
        debsums|aide|needrestart) [ -n "${inst[$n]:-}" ] && st=installed ;;
        unattended) [ -n "${inst[unattended-upgrades]:-}" ] && st=installed ;;
        wireguard) [ -n "${inst[wireguard-tools]:-}" ] && st=installed ;;
        dnscrypt) [ -n "${inst[dnscrypt-proxy]:-}" ] && st=installed ;;
        crowdsec)
          if [ -n "${inst[crowdsec]:-}" ] && { [ -n "${inst[crowdsec-firewall-bouncer]:-}" ] || [ -n "${inst[crowdsec-firewall-bouncer-iptables]:-}" ]; }; then
            st=installed
          elif [ -n "${inst[crowdsec]:-}" ] || [ -n "${inst[crowdsec-firewall-bouncer]:-}" ] || [ -n "${inst[crowdsec-firewall-bouncer-iptables]:-}" ]; then st=partial; fi ;;
      esac
    fi
    # Some DietPi/source deployments have working binaries without apt packages.
    case "$n" in
      suricata) command -v suricata >/dev/null 2>&1 && st=installed ;;
      wireguard) { command -v wg >/dev/null 2>&1 || command -v dietpi-wireguard >/dev/null 2>&1 || [ -x /boot/dietpi/dietpi-wireguard ]; } && st=installed ;;
      unbound) command -v unbound-checkconf >/dev/null 2>&1 && st=installed ;;
      dnscrypt) command -v dnscrypt-proxy >/dev/null 2>&1 && st=installed ;;
    esac
    cand=unknown
    if [ "$st" = installed ]; then cand=yes
    elif [ "$apt_known" -eq 1 ]; then
      cand=yes
      # Status is a discovery operation; don't call tool_pkgs(), which can
      # independently invoke apt-cache for CrowdSec and hang again.
      case "$n" in
        crowdsec) q='crowdsec ipset'; [ -n "${offered[crowdsec-firewall-bouncer]:-}" ] || [ -n "${offered[crowdsec-firewall-bouncer-iptables]:-}" ] || cand=no ;;
        fail2ban) q='fail2ban python3-systemd' ;;
        wireguard) q='wireguard-tools qrencode' ;;
        clamav) q='clamav clamav-freshclam' ;;
        clamavd) q='clamav-daemon clamdscan' ;;
        xtables) q='xtables-addons-common xtables-addons-dkms' ;;
        unattended) q='unattended-upgrades apt-listchanges' ;;
        unbound) q='unbound dns-root-data bind9-dnsutils' ;;
        dnscrypt) q='dnscrypt-proxy bind9-dnsutils' ;;
        *) q="$n" ;;
      esac
      for p in $q; do [ -n "${offered[$p]:-}" ] || { cand=no; break; }; done
    fi
    sv='-'
    if [ "$svc_known" -eq 0 ]; then
      [ -n "$(tool_svcs "$n")" ] && sv='n/d'
      run=unknown
    else
      for q in $(tool_svcs "$n"); do
        val="${active[$q]:-unknown}"; sv="${sv#-}${val}/"
      done
      sv="${sv%/}"; [ -n "$sv" ] || sv='-'
      case "${active[iptm-tool-$n.service]:-unknown}" in
        active|activating|reloading) run=running ;;
        inactive|failed|unknown|deactivating) run=idle ;;
        *) run=unknown ;;
      esac
    fi
    printf '%s %s %s %s %s\n' "$n" "$st" "$sv" "$cand" "$run"
  done
}

tool_pkgs() { case "$1" in
  wireguard) echo "wireguard-tools qrencode";;
  fail2ban) echo "fail2ban python3-systemd";;
  crowdsec) echo "crowdsec $(cs_bouncer_pkg) ipset";;
  suricata) echo "suricata";;
  vnstat) echo "vnstat";;
  tcpdump) echo "tcpdump";;
  conntrack) echo "conntrack";;
  xtables) echo "xtables-addons-common xtables-addons-dkms";;
  psad) echo "psad";;
  arpwatch) echo "arpwatch";;
  unattended) echo "unattended-upgrades apt-listchanges";;
  auditd) echo "auditd";;
  lynis) echo "lynis";;
  unbound) echo "unbound dns-root-data bind9-dnsutils";;
  dnscrypt) echo "dnscrypt-proxy bind9-dnsutils";;
  ipset) echo "ipset";;
  clamav) echo "clamav clamav-freshclam";;
  clamavd) echo "clamav-daemon clamdscan";;
  debsums) echo "debsums";;
  aide) echo "aide";;
  needrestart) echo "needrestart";;
  *) return 1;;
esac; }
tool_pkg_installed() { # dpkg -s è positivo anche per residual-config; serve lo stato effettivo.
  [ "$(dpkg-query -W '-f=${Status}' "$1" 2>/dev/null)" = 'install ok installed' ]
}
tool_present() {   # pacchetto apt oppure (suricata) binario compilato da sorgenti
  [ "$1" = suricata ] && command -v suricata >/dev/null 2>&1 && return 0
  [ "$1" = unbound ] && command -v unbound-checkconf >/dev/null 2>&1 && return 0
  [ "$1" = dnscrypt ] && { command -v dnscrypt-proxy >/dev/null 2>&1 || tool_pkg_installed dnscrypt-proxy; } && return 0
  [ "$1" = wireguard ] && { command -v wg >/dev/null 2>&1 || command -v dietpi-wireguard >/dev/null 2>&1 || [ -x /boot/dietpi/dietpi-wireguard ]; } && return 0
  if [ "$1" = crowdsec ]; then tool_pkg_installed crowdsec && { tool_pkg_installed crowdsec-firewall-bouncer || tool_pkg_installed crowdsec-firewall-bouncer-iptables; }; return; fi
  tool_pkg_installed "$(tool_pkgs "$1" | awk '{print $1}')"
}
tool_svcs() { case "$1" in
  fail2ban) echo "fail2ban";;
  crowdsec) echo "crowdsec crowdsec-firewall-bouncer";;
  suricata) echo "suricata";;
  vnstat) echo "vnstat";;
  psad) echo "psad";;
  arpwatch) echo "arpwatch";;
  unattended) echo "unattended-upgrades";;
  auditd) echo "auditd";;
  unbound) echo "unbound";;
  dnscrypt) echo "dnscrypt-proxy.service";;
  clamav) echo "clamav-freshclam";;
  clamavd) echo "clamav-daemon";;
  *) echo "";;
esac; }
post_add() {   # aggiunge un servizio da riavviare dopo ogni applicazione delle regole (le catene dei bouncer vanno ricreate)
  case " $POST_SERVICES " in *" $1 "*) return 0;; esac
  POST_SERVICES="$(echo "$POST_SERVICES $1" | xargs)"; conf_set POST_SERVICES "$POST_SERVICES"
}
dnscrypt_listener_rows() {
  command -v ss >/dev/null 2>&1 || return 0
  # Include protocol + local address: socket activation exposes descriptors owned by systemd.
  # Con BindToDevice=lo ss scrive 127.0.0.1%lo:5053: tolgo il suffisso %interfaccia (un indirizzo non-loopback resta tale e viene rifiutato)
  ss -H -lntu 2>/dev/null | awk '$5 ~ /:5053$/ {a=$5; sub(/%[^:\]]+:5053$/, ":5053", a); print $1 "\t" a}' | sort -u
}
dnscrypt_listeners() {
  dnscrypt_listener_rows | awk -F '\t' 'NF >= 2 {print $2}' | sort -u
}
# Due modalita' di esposizione, scelte in base al sistema:
#   socket = esiste dnscrypt-proxy.socket (pacchetto Debian): drop-in systemd loopback, listen_addresses = []
#   native = nessuna unit socket (DietPi, binario upstream): il servizio ascolta da solo, legato a 127.0.0.1:5053 dal TOML
dnscrypt_socket_unit() { systemctl cat dnscrypt-proxy.socket >/dev/null 2>&1; }
dnscrypt_mode_name() { if dnscrypt_socket_unit; then echo socket; else echo native; fi; }
dnscrypt_unit_active() {
  if dnscrypt_socket_unit; then systemctl is-active --quiet dnscrypt-proxy.socket 2>/dev/null
  else systemctl is-active --quiet dnscrypt-proxy.service 2>/dev/null; fi
}
dnscrypt_need_profile() {
  if dnscrypt_socket_unit; then echo "DNSCrypt non usa il socket systemd IPTM su loopback: salva prima il profilo da DNS & Privacy"
  else echo "DNSCrypt non usa il profilo IPTM (listener nativo solo su 127.0.0.1:5053): salva prima il profilo da DNS & Privacy"; fi
}
dnscrypt_profile_configured() {
  local f=/etc/dnscrypt-proxy/dnscrypt-proxy.toml dropin=/etc/systemd/system/dnscrypt-proxy.socket.d/zz-iptm-loopback-5053.conf want
  want=$(dnscrypt_mode_name)
  python3 - "$f" "$want" <<'PY_DNSCRYPT_PROFILE' || return 1
import sys,tomllib
try:
 with open(sys.argv[1],'rb') as f: d=tomllib.load(f)
 la=d.get('listen_addresses')
 ok = (la == []) if sys.argv[2] == 'socket' else (la == ['127.0.0.1:5053'])
except Exception: raise SystemExit(1)
raise SystemExit(0 if ok else 1)
PY_DNSCRYPT_PROFILE
  grep -Fqx '# IPTM managed DNSCrypt settings' "$f" 2>/dev/null || return 1
  [ "$want" = socket ] || return 0
  [ -f "$dropin" ] && [ ! -L "$dropin" ] || return 1
  grep -Fqx '# IPTM managed DNSCrypt systemd socket · loopback only' "$dropin" || return 1
  grep -Fqx 'ListenStream=' "$dropin" && grep -Fqx 'ListenDatagram=' "$dropin" \
    && grep -Fqx 'BindToDevice=lo' "$dropin" \
    && grep -Fqx 'ListenStream=127.0.0.1:5053' "$dropin" \
    && grep -Fqx 'ListenDatagram=127.0.0.1:5053' "$dropin"
}
dnscrypt_listener_safe() {
  local rows proto addr tcp=0 udp=0
  command -v ss >/dev/null 2>&1 || { echo "comando ss non disponibile (installa iproute2): impossibile verificare i listener DNSCrypt" >&2; return 1; }
  rows=$(dnscrypt_listener_rows)
  [ -n "$rows" ] || { echo "nessun listener TCP/UDP rilevato su 127.0.0.1:5053" >&2; return 1; }
  while IFS=$'\t' read -r proto addr; do
    [ -n "$proto" ] || continue
    case "$proto" in tcp*|udp*) ;; *) echo "protocollo listener DNSCrypt inatteso: $proto" >&2; return 1 ;; esac
    case "$addr" in
      127.0.0.1:5053) case "$proto" in tcp*) tcp=1 ;; udp*) udp=1 ;; esac ;;
      '[::1]:5053') ;;   # loopback IPv6: raggiungibile solo dalla macchina stessa, non e' un'esposizione
      *) echo "listener DNSCrypt non limitato al loopback: $proto $addr" >&2; return 1 ;;
    esac
  done <<< "$rows"
  [ "$tcp" = 1 ] && [ "$udp" = 1 ] || { echo "mancano listener TCP e/o UDP su 127.0.0.1:5053" >&2; return 1; }
  dnscrypt_unit_active || { echo "DNSCrypt ($(dnscrypt_mode_name)) non è attivo" >&2; return 1; }
}
unbound_dnssec_ready() {
  command -v unbound-checkconf >/dev/null 2>&1 && command -v dig >/dev/null 2>&1 || return 1
  systemctl is-active --quiet unbound || return 1
  unbound-checkconf >/dev/null 2>&1 || return 1
  local modules anchor flags
  modules=$(unbound-checkconf -o module-config 2>/dev/null | tr -d '"')
  [[ " $modules " == *" validator "* ]] || return 1
  anchor=$(unbound-checkconf -o auto-trust-anchor-file 2>/dev/null | sed -e 's/^"//' -e 's/"$//')
  [[ "$anchor" =~ ^/[A-Za-z0-9._/+:-]+$ ]] && [ -r "$anchor" ] || return 1
  flags=$(timeout 8 dig +time=2 +tries=1 +dnssec +adflag @127.0.0.1 -p 5335 cloudflare.com A +noall +comments 2>/dev/null || true)
  grep -Eqi 'flags:.*(^|[[:space:];])ad([[:space:];]|$)' <<< "$flags"
}
dnscrypt_apply() { # $1=auto|dnscrypt|doh; systemd socket loopback come da guida ufficiale Pi-hole
  local mode="${1:-auto}" f=/etc/dnscrypt-proxy/dnscrypt-proxy.toml dir=/etc/dnscrypt-proxy
  local sockdir=/etc/systemd/system/dnscrypt-proxy.socket.d dropin=/etc/systemd/system/dnscrypt-proxy.socket.d/zz-iptm-loopback-5053.conf
  [[ "$mode" =~ ^(auto|dnscrypt|doh)$ ]] || { echo "protocollo DNSCrypt non valido" >&2; return 2; }
  command -v dnscrypt-proxy >/dev/null 2>&1 || { echo "dnscrypt-proxy non installato" >&2; return 1; }
  command -v dig >/dev/null 2>&1 && command -v ss >/dev/null 2>&1 || { echo "servono bind9-dnsutils e iproute2 per validare DNSCrypt" >&2; return 1; }
  local want; want=$(dnscrypt_mode_name)   # socket (unit Debian presente) oppure native (DietPi / binario upstream)
  mkdir -p "$dir" || return 1
  if [ ! -s "$f" ]; then
    local sample=""
    for sample in /usr/share/doc/dnscrypt-proxy/examples/example-dnscrypt-proxy.toml /usr/share/doc/dnscrypt-proxy/examples/dnscrypt-proxy.toml /usr/share/doc/dnscrypt-proxy/examples/example-dnscrypt-proxy.toml.gz /usr/share/dnscrypt-proxy/dnscrypt-proxy.toml; do [ -s "$sample" ] && break; done
    [ -s "$sample" ] || { echo "configurazione TOML e sorgenti resolver firmate non trovate; non creo un resolver senza fonti ufficiali" >&2; return 1; }
    case "$sample" in *.gz) gzip -dc "$sample" > "$f" || return 1 ;; *) cp -a "$sample" "$f" || return 1 ;; esac
  fi
  [ -f "$f" ] && [ ! -L "$f" ] || { echo "il file DNSCrypt non è un file regolare (symlink rifiutato)" >&2; return 1; }
  grep -Eq '^\[sources([.]|])' "$f" && grep -q 'minisign_key' "$f" || { echo "mancano le fonti resolver firmate: aggiorna/copia il file esempio ufficiale prima di configurare DNSCrypt" >&2; return 1; }
  if [ "$want" = socket ] && [ -e "$dropin" ] && { [ ! -f "$dropin" ] || ! grep -Fqx '# IPTM managed DNSCrypt systemd socket · loopback only' "$dropin"; }; then
    echo "esiste già $dropin non gestito da IPTM: non lo sovrascrivo" >&2; return 1
  fi
  local was_socket=0 was_service=0 had_dropin=0
  systemctl is-active --quiet dnscrypt-proxy.socket 2>/dev/null && was_socket=1
  systemctl is-active --quiet dnscrypt-proxy.service 2>/dev/null && was_service=1
  local backup="$f.iptm-bak-$(date +%Y%m%d-%H%M%S)-$$" backup_dropin=""
  cp -a "$f" "$backup" || return 1
  if [ -f "$dropin" ]; then
    backup_dropin="$dropin.iptm-bak-$(date +%Y%m%d-%H%M%S)-$$"
    cp -a "$dropin" "$backup_dropin" || return 1; had_dropin=1
  fi
  dnscrypt_rollback() {
    cp -a "$backup" "$f" 2>/dev/null || true
    if [ "$had_dropin" = 1 ]; then cp -a "$backup_dropin" "$dropin" 2>/dev/null || true; else rm -f "$dropin"; fi
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "$was_socket" = 1 ]; then systemctl enable --now dnscrypt-proxy.socket >/dev/null 2>&1 || true
    else systemctl disable --now dnscrypt-proxy.socket >/dev/null 2>&1 || true; fi
    if [ "$was_service" = 1 ]; then systemctl restart dnscrypt-proxy.service >/dev/null 2>&1 || true
    else systemctl stop dnscrypt-proxy.service >/dev/null 2>&1 || true; fi
  }
  if ! python3 - "$f" "$mode" "$want" <<'PY_DNSCRYPT'
import os,re,sys
path,mode,want=sys.argv[1:]
text=open(path,encoding='utf-8').read()
lines=text.splitlines()
idx=next((i for i,x in enumerate(lines) if re.match(r'^\s*\[[^]]+\]',x)),len(lines))
root=lines[:idx]; rest=lines[idx:]
keys={'listen_addresses','server_names','ipv4_servers','ipv6_servers','dnscrypt_servers','doh_servers','odoh_servers','require_dnssec','require_nolog','require_nofilter','cache','cache_size','ignore_system_dns'}
new=[]
for line in root:
    m=re.match(r'^\s*([A-Za-z0-9_]+)\s*=',line)
    if m and m.group(1) in keys: continue
    new.append(line)
block=['# IPTM managed DNSCrypt settings',"listen_addresses = []" if want=='socket' else "listen_addresses = ['127.0.0.1:5053']",'server_names = []',
       'ipv4_servers = true','ipv6_servers = false',
       'dnscrypt_servers = '+('true' if mode in ('auto','dnscrypt') else 'false'),
       'doh_servers = '+('true' if mode in ('auto','doh') else 'false'),
       'odoh_servers = false','require_dnssec = true','require_nolog = true','require_nofilter = true',
       'cache = true','cache_size = 4096','ignore_system_dns = true','']
out='\n'.join(new+block+rest).rstrip()+'\n'
if not re.search(r'^\[sources(?:\.|\])',out,re.M) or 'minisign_key' not in out:
    raise SystemExit('fonti resolver firmate assenti o non riconosciute')
tmp=path+'.iptm-tmp'
with open(tmp,'w',encoding='utf-8') as f: f.write(out); f.flush(); os.fsync(f.fileno())
st=os.stat(path); os.chmod(tmp,st.st_mode & 0o777); os.chown(tmp,st.st_uid,st.st_gid)
os.replace(tmp,path)
PY_DNSCRYPT
  then dnscrypt_rollback; echo "impossibile aggiornare il TOML DNSCrypt" >&2; return 1; fi
  if [ "$want" = socket ]; then
  mkdir -p "$sockdir" || { dnscrypt_rollback; return 1; }
  local tmp_dropin="$dropin.iptm-tmp"
  cat > "$tmp_dropin" <<'DNSCRYPT_SOCKET'
# IPTM managed DNSCrypt systemd socket · loopback only
[Socket]
ListenStream=
ListenDatagram=
BindToDevice=lo
ListenStream=127.0.0.1:5053
ListenDatagram=127.0.0.1:5053
DNSCRYPT_SOCKET
  chmod 0644 "$tmp_dropin" && chown root:root "$tmp_dropin" && mv -f "$tmp_dropin" "$dropin" || { dnscrypt_rollback; echo "impossibile scrivere il drop-in systemd DNSCrypt" >&2; return 1; }
  fi
  local dnscheck_log
  dnscheck_log=$(mktemp /tmp/iptm-dnscrypt-check.XXXXXXXX) || { dnscrypt_rollback; return 1; }
  chmod 0600 "$dnscheck_log"
  if ! (cd "$dir" && timeout 15 dnscrypt-proxy -check) >"$dnscheck_log" 2>&1; then
    local dnscheck_tail
    dnscheck_tail=$(tail -n 8 "$dnscheck_log")
    rm -f -- "$dnscheck_log"
    dnscrypt_rollback
    echo "dnscrypt-proxy -check non riuscito: $dnscheck_tail" >&2; return 1
  fi
  rm -f -- "$dnscheck_log"
  if [ "$want" = socket ]; then
  # Il pacchetto Debian lega il servizio alla socket unit: la porta effettiva va impostata nel drop-in.
  systemctl stop dnscrypt-proxy.service >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || { dnscrypt_rollback; echo "systemd daemon-reload non riuscito" >&2; return 1; }
  systemctl enable --now dnscrypt-proxy.socket >/dev/null 2>&1 || { dnscrypt_rollback; echo "impossibile attivare dnscrypt-proxy.socket" >&2; return 1; }
  systemctl restart dnscrypt-proxy.socket >/dev/null 2>&1 || { dnscrypt_rollback; echo "impossibile riavviare la socket DNSCrypt" >&2; return 1; }
  systemctl restart dnscrypt-proxy.service >/dev/null 2>&1 || { dnscrypt_rollback; echo "impossibile avviare dnscrypt-proxy con la socket loopback" >&2; return 1; }
  else   # listener nativo: nessuna unit socket, il servizio legge listen_addresses dal TOML
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable dnscrypt-proxy.service >/dev/null 2>&1 || true
    systemctl restart dnscrypt-proxy.service >/dev/null 2>&1 || { dnscrypt_rollback; echo "impossibile riavviare dnscrypt-proxy con il listener 127.0.0.1:5053" >&2; return 1; }
  fi
  if ! timeout 12 dig +time=3 +tries=1 @127.0.0.1 -p 5053 example.com A +short | grep -q .; then
    dnscrypt_rollback; echo "DNSCrypt non risponde su 127.0.0.1:5053 dopo l'attivazione systemd; configurazioni precedenti ripristinate" >&2; return 1
  fi
  if ! dnscrypt_profile_configured || ! dnscrypt_listener_safe; then
    dnscrypt_rollback; echo "DNSCrypt non risulta limitato a TCP/UDP 127.0.0.1:5053 ($(dnscrypt_listener_safe 2>&1 | head -1)); configurazioni precedenti ripristinate" >&2; return 1
  fi
  backup_rotate_files "$(dirname "$f")" "$(basename "$f").iptm-bak-" || echo 'AVVISO: rotazione DNSCrypt differita' >&2
  if [ "$had_dropin" = 1 ]; then backup_rotate_files "$(dirname "$dropin")" "$(basename "$dropin").iptm-bak-" || true; fi
  echo "DNSCrypt configurato ($([ "$want" = socket ] && echo 'systemd socket, BindToDevice=lo' || echo 'listener nativo del servizio')) su 127.0.0.1:5053 (TCP+UDP, modalità $mode, pool resolver firmato con requisiti DNSSEC/no-log/no-filter). Backup: $backup"
}

dns_stack_apply() { # $1=unbound|dnscrypt|layered
  local mode="${1:-}" p=/etc/pihole/pihole.toml uf=/etc/unbound/unbound.conf.d/iptm-dnscrypt-forward.conf
  [[ "$mode" =~ ^(unbound|dnscrypt|layered)$ ]] || return 2
  command -v pihole-FTL >/dev/null 2>&1 && [ -r "$p" ] || { echo "Pi-hole FTL v6 non rilevato" >&2; return 1; }
  local pid; pid=$(pgrep -xo pihole-FTL 2>/dev/null || true)
