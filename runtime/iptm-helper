}
# Retain ten completed automatic backups per source. Never follow symlinks,
# never remove active DNS/update journals, and never delete arbitrary globs.
backup_rotate_files() { # directory, literal filename prefix, file|dir, retained count
  python3 - "$1" "$2" "${3:-file}" "${4:-10}" <<'PY_BACKUP_ROTATE'
import os,stat,sys
root,prefix,kind,keep_raw=sys.argv[1:]
if keep_raw not in ('3','10'):raise SystemExit(2)
keep=int(keep_raw)
if not os.path.isdir(root) or os.path.islink(root) or not prefix or '/' in prefix or kind not in ('file','dir'):
    raise SystemExit(2)
entries=[]
with os.scandir(root) as scan:
    for entry in scan:
        if not entry.name.startswith(prefix) or entry.is_symlink(): continue
        # Upgrade-related backups only: never prune manually named snapshots.
        import re
        if keep==3:
            if kind=='dir' and prefix=='pre-update-':
                if not re.fullmatch(r'pre-update-(?:\d+\.\d+\.\d+|old)-\d{8}-\d{6}',entry.name):continue
            elif kind=='dir' and prefix=='fw-guard-':
                if not re.fullmatch(r'fw-guard-\d{8}-\d{6}',entry.name):continue
            elif kind=='file' and '.bak-' in prefix:
                if not re.fullmatch(re.escape(prefix)+r'(?:(?:\d+\.\d+\.\d+|old)-)?\d{8}-\d{6}',entry.name):continue
            else:continue
        if prefix in ('rules.v4.','rules.v6.'):
            import re
            if not re.fullmatch(r'rules\.v[46]\.\d{8}-\d{6}(?:-[a-fA-F0-9]{8})?',entry.name):continue
        if prefix=='settings.' and not entry.name.endswith('.json'):continue
        try:
            st=entry.stat(follow_symlinks=False)
        except OSError: continue
        if kind=='file' and not stat.S_ISREG(st.st_mode):continue
        if kind=='dir' and not stat.S_ISDIR(st.st_mode):continue
        entries.append((st.st_mtime_ns,entry.name,st.st_ino))
entries.sort(reverse=True)
for _,name,ino in entries[keep:]:
    path=os.path.join(root,name)
    try:
        st=os.lstat(path)
        if st.st_ino!=ino or (kind=='file' and not stat.S_ISREG(st.st_mode)) or (kind=='dir' and not stat.S_ISDIR(st.st_mode)):continue
        if kind=='file':os.unlink(path)
        else:
            # Only transaction directories with the exact trusted layout are
            # pruned here; never traverse symlinked contents on the filesystem.
            import shutil
            shutil.rmtree(path)
    except OSError as exc:
        print('IPTM: rotazione backup non completata:',str(exc)[:140],file=sys.stderr)
        raise SystemExit(1)
PY_BACKUP_ROTATE
}
