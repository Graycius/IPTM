# Percorsi rilevati, nell'ordine: SURICATA_YAML in /etc/iptables-manager.conf, argomento -c del processo, unit systemd, percorsi noti.
# Log, regole e socket si leggono poi dal suricata.yaml, quindi funziona con qualsiasi --prefix/--sysconfdir/--localstatedir.
yaml_val() { sed -nE "s/^[[:space:]]*$1:[[:space:]]*([^#]*[^#[:space:]]).*/\1/p" "$SU_YAML" 2>/dev/null | head -1 | tr -d "\"'"; }
