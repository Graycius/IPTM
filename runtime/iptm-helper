snapshot_cfg() {   # atomic pre-update snapshot, never claim success on partial copies
  local parent="$1/backups" dest="$1/backups/pre-update-$2" tmp file count=0
  [[ "$2" =~ ^[A-Za-z0-9._-]{1,90}$ ]] || return 2
