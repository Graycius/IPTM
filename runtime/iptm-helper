      | curl --silent --max-time 8 --proto '=https' --config - >/dev/null 2>&1 || true
  fi
  if [ -n "$wh" ]; then
    { printf 'url = %s\n' "$(curl_cfg_value "$wh")"
      printf 'data = %s\n' "$(curl_cfg_value "$t")"; } \
      | curl --silent --max-time 8 --proto '=https' --config - >/dev/null 2>&1 || true
