yaml_put() {   # yaml_put file chiave valore: sostituisce (o aggiunge) una chiave di primo livello
  local t; t=$(mktemp); awk -v k="$2" -v v="$3" 'BEGIN{d=0} $0 ~ "^"k":" && !d {print k": "v; d=1; next} {print} END{if(!d) print k": "v}' "$1" > "$t" && cat "$t" > "$1"; rm -f "$t"
