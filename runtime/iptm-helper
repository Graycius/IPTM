        [ -f "$p" ] && printf -- '-w %s -p wa -k iptm-config\n' "$p" >> "$t"
      done
      for p in /etc/wireguard/*.conf /etc/wireguard/clients/*.conf; do
        [ -f "$p" ] && printf -- '-w %s -p wa -k iptm-wireguard\n' "$p" >> "$t"
      done
      [ -s "$t" ] || { rm -f "$t"; echo "nessun percorso di configurazione trovato per Auditd" >&2; return 1; }
      chmod 0640 "$t" || { rm -f "$t"; return 1; }
      had_old=0
      if [ -f "$f" ]; then cp -a "$f" "$f.bak" || { rm -f "$t"; return 1; }; had_old=1; fi
      mv -f "$t" "$f" || { rm -f "$t"; return 1; }
      # Starting auditd first avoids loading rules into a disabled kernel audit service.
      if ! systemctl is-active --quiet auditd; then
        if ! systemctl enable --now auditd 2>&1 && ! systemctl start auditd 2>&1; then
          [ "$had_old" = 1 ] && cp -a "$f.bak" "$f" || rm -f "$f"
          echo 'auditd installato ma non avviabile: verifica systemctl status auditd, journalctl -u auditd e supporto CONFIG_AUDIT del kernel.' >&2
          return 1
        fi
      fi
      if ! systemctl is-active --quiet auditd; then
        [ "$had_old" = 1 ] && cp -a "$f.bak" "$f" || rm -f "$f"
        echo 'auditd non attivo: nessuna regola IPTM applicata' >&2; return 1
      fi
      if command -v auditctl >/dev/null 2>&1 && ! auditctl -s >/dev/null 2>&1; then
        [ "$had_old" = 1 ] && cp -a "$f.bak" "$f" || rm -f "$f"
        echo 'Kernel audit non disponibile: auditctl -s fallisce. Controlla CONFIG_AUDIT, container e privilegi.' >&2; return 1
      fi
      if command -v augenrules >/dev/null 2>&1; then
        augenrules --load || { [ "$had_old" = 1 ] && cp -a "$f.bak" "$f" || rm -f "$f"; augenrules --load >/dev/null 2>&1 || true; echo 'Impossibile caricare le regole auditd: controlla formato e supporto kernel.' >&2; return 1; }
      elif command -v auditctl >/dev/null 2>&1; then
        auditctl -R "$f" || { [ "$had_old" = 1 ] && cp -a "$f.bak" "$f" || rm -f "$f"; echo 'auditctl ha rifiutato le regole IPTM' >&2; return 1; }
      else
        [ "$had_old" = 1 ] && cp -a "$f.bak" "$f" || rm -f "$f"
        echo 'auditctl/augenrules non disponibile' >&2; return 1
      fi
      echo "Auditd attivo: monitora regole firewall, configurazioni WireGuard e SSH (chiavi iptm-config/iptm-wireguard)" ;;
    unattended)
      # aggiornamenti di sicurezza automatici (best practice hardening)
      f=/etc/apt/apt.conf.d/50unattended-upgrades
      if [ -f "$f" ]; then
        # abilita origin Debian/Ubuntu security
        sed -i 's#//\s*"origin=Debian,codename=\${distro_codename},label=Debian-Security"#        "origin=Debian,codename=${distro_codename},label=Debian-Security"#' "$f" 2>/dev/null || true
      fi
      echo 'APT::Periodic::Update-Package-Lists "1";' > /etc/apt/apt.conf.d/20auto-upgrades
      echo 'APT::Periodic::Unattended-Upgrade "1";' >> /etc/apt/apt.conf.d/20auto-upgrades
      echo 'APT::Periodic::AutocleanInterval "7";' >> /etc/apt/apt.conf.d/20auto-upgrades
      systemctl enable unattended-upgrades >/dev/null 2>&1; systemctl restart unattended-upgrades 2>&1
      echo "unattended-upgrades attivo: patch di sicurezza automatiche ogni giorno" ;;
    *) ;;
  esac
}
watch_checks() {   # stampa "STATO chiave messaggio" (OK|WARN|FAIL)
  local w c m pct n live file age s u
  w=$(sed -n 's/^BACKEND_WANTED="\(legacy\|nft\)"$/\1/p' "$CONF" 2>/dev/null); c=$(iptables -V 2>/dev/null | grep -q legacy && echo legacy || echo nft)
  if [ -n "$w" ] && [ "$w" != "$c" ]; then echo "FAIL backend il backend iptables e' $c ma era stato scelto $w (aggiornamento di sistema?)"; else echo "OK backend backend iptables: $c"; fi
  live=$(iptables-save 2>/dev/null | grep -c '^-A '); file=$(grep -c '^-A ' "$R4" 2>/dev/null)
  if [ "${file:-0}" -gt 0 ] && [ "${live:-0}" -eq 0 ]; then echo "FAIL regole le regole attive sono vuote ma $R4 ne contiene $file"; else echo "OK regole $live regole attive"; fi
  if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then n=$(cat /proc/sys/net/netfilter/nf_conntrack_count); m=$(cat /proc/sys/net/netfilter/nf_conntrack_max); pct=$(( n * 100 / ${m:-1} ))
    if [ "$pct" -ge 95 ]; then echo "FAIL conntrack tabella di tracking al $pct% ($n/$m)"; elif [ "$pct" -ge 80 ]; then echo "WARN conntrack tabella di tracking all'$pct% ($n/$m)"; else echo "OK conntrack tabella di tracking al $pct% ($n/$m)"; fi; fi
  for f in "$VAR"/*.ts; do [ -f "$f" ] || continue; age=$(( ( $(date +%s) - $(cat "$f" 2>/dev/null || echo 0) ) / 3600 )); s=$(basename "$f" .ts)
    if [ "$age" -gt 72 ]; then echo "WARN lista-$s la lista $s non si aggiorna da $age ore"; else echo "OK lista-$s lista $s aggiornata $age ore fa"; fi; done
  for u in fail2ban crowdsec crowdsec-firewall-bouncer suricata vnstat psad arpwatch auditd dnscrypt-proxy.socket dnscrypt-proxy.service; do
    if systemctl is-enabled --quiet "$u" 2>/dev/null; then if systemctl is-active --quiet "$u"; then echo "OK servizio-$u $u attivo"; else echo "FAIL servizio-$u $u e' abilitato ma non attivo"; fi; fi; done
  if systemctl is-active --quiet crowdsec-firewall-bouncer 2>/dev/null && ! iptables -S CROWDSEC_CHAIN >/dev/null 2>&1 && ! nft list tables 2>/dev/null | grep -qi crowdsec; then echo "WARN crowdsec-catena il bouncer e' attivo ma non esiste la catena CROWDSEC_CHAIN ne' la tabella nft (chiave API o modo errato)"; fi
  pct=$(df --output=pcent /var 2>/dev/null | tail -1 | tr -dc 0-9); [ -n "$pct" ] && { [ "$pct" -ge 90 ] && echo "WARN disco /var pieno al $pct%" || echo "OK disco /var al $pct%"; }
  return 0
}
conf_set() { sed -i "/^$1=/d" "$CONF" 2>/dev/null; printf '%s="%s"\n' "$1" "$2" >> "$CONF"; }
conf_del() { sed -i "/^$1=/d" "$CONF" 2>/dev/null; }
# Write the entire SQM profile at once. A torn set of individual conf_set
# calls can leave the persistent rate different from live CAKE after I/O error.
# Apply scheduler state in one atomic write; the previous conf_set-based
# sequence could leave autocal enabled with the old interval after an I/O error.
sqm_timer_conf_commit() { # interval min, enabled(0/1)
  local interval="$1" enabled="$2" tmp
  [[ "$interval" =~ ^[0-9]{1,4}$ && "$enabled" =~ ^[01]$ ]] &&
    [ "$interval" -ge 15 ] && [ "$interval" -le 1440 ] || return 2
  tmp=$(mktemp "${CONF}.timer.XXXXXXXX") || return 1
  chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
  if [ -f "$CONF" ]; then
    awk '!/^[[:space:]]*(SQM_INTERVAL_MIN|SQM_AUTOCAL)[[:space:]]*=/' "$CONF" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  printf 'SQM_INTERVAL_MIN="%s"\nSQM_AUTOCAL="%s"\n' "$interval" "$enabled" >> "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f -- "$tmp" "$CONF" || { rm -f "$tmp"; return 1; }
}
sqm_conf_commit() {  # iface up down diffserv ack nat overhead wash
  local iface="$1" up="$2" dn="$3" ds="$4" ack="$5" nat="$6" ov="$7" wash="$8"
  local tmp mode
  [[ "$iface" =~ ^[A-Za-z0-9_.-]{1,15}$ && "$up" =~ ^[0-9]{1,6}$ && "$dn" =~ ^[0-9]{1,6}$ ]] || return 2
  [[ "$ds" =~ ^(besteffort|diffserv3|diffserv4|diffserv8)$ ]] || return 2
  [[ "$ack" =~ ^[01]$ && "$nat" =~ ^[01]$ && "$wash" =~ ^[01]$ ]] || return 2
  [[ "$ov" =~ ^(none|ethernet|pppoe-v4|pppoe-ptm|bridged-ptm|conservative)$ ]] || return 2
  tmp=$(mktemp "${CONF}.sqm.XXXXXXXX") || return 1
  chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
  if [ -f "$CONF" ]; then
    awk '!/^[[:space:]]*(SQM_IF|SQM_UP|SQM_DOWN|SQM_DIFFSERV|SQM_ACK|SQM_NAT|SQM_OVERHEAD|SQM_WASH)[[:space:]]*=/' "$CONF" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  printf 'SQM_IF="%s"\nSQM_UP="%s"\nSQM_DOWN="%s"\nSQM_DIFFSERV="%s"\nSQM_ACK="%s"\nSQM_NAT="%s"\nSQM_OVERHEAD="%s"\nSQM_WASH="%s"\n' \
    "$iface" "$up" "$dn" "$ds" "$ack" "$nat" "$ov" "$wash" >> "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f -- "$tmp" "$CONF" || { rm -f "$tmp"; return 1; }
}
sqm_recover_after_persist_error() {  # prior iface/up/down, or empty if first-time config
  local iface="$1" up="$2" down="$3" target="$4"
  if [[ "$iface" =~ ^[A-Za-z0-9_.-]{1,15}$ && "$up" =~ ^[0-9]{1,6}$ && "$down" =~ ^[0-9]{1,6}$ ]] &&
     [ "$up" -gt 0 ] && [ "$down" -gt 0 ]; then
    # qdisc is now managed CAKE but the config still describes the old rate.
    if sqm_apply_raw "$iface" "$up" "$down" >/dev/null; then
      echo 'SQM: scrittura impostazioni fallita; CAKE precedente ripristinato' >&2
    else
      echo 'SQM CRITICO: configurazione su disco invariata ma rollback tc fallito' >&2
    fi
  else
    tc qdisc del dev "$target" ingress 2>/dev/null || true
    tc qdisc del dev "$target" root 2>/dev/null || true
    tc qdisc del dev ifb-sqm root 2>/dev/null || true
    echo 'SQM: scrittura impostazioni fallita, nuovo CAKE rimosso' >&2
  fi
}
sqm_apply_raw() {  # $1=iface $2=up Mbit $3=down Mbit  — prioritizzazione tipo cFosSpeed via CAKE diffserv
  modprobe -q sch_cake 2>/dev/null; modprobe -q ifb 2>/dev/null
  local dev="$1" up="$2" dn="$3"
  local ds="${SQM_DIFFSERV:-diffserv4}"
  local ack="${SQM_ACK:-ack-filter}"
  local nat="${SQM_NAT:-nat}"
  local ov="${SQM_OVERHEAD:-ethernet}"
  local wash="${SQM_WASH:-}"
  local ov_opt="" rc=0
  case "$ov" in
    ""|none) ov_opt="" ;;
    ethernet) ov_opt="ethernet" ;;
    raw) ov_opt="raw" ;;
    atm) ov_opt="atm" ;;
    pppoe-v4|pppoe) ov_opt="overhead 40" ;;
    pppoe-ptm) ov_opt="overhead 30" ;;
    bridged-ptm) ov_opt="overhead 22" ;;
    conservative) ov_opt="overhead 48" ;;
    -*|*[!0-9-]*)
      if printf '%s' "$ov" | grep -qE '^-?[0-9]+$'; then
        local n=$ov
        [ "$n" -lt -64 ] && n=-64
        [ "$n" -gt 256 ] && n=256
        ov_opt="overhead $n"
      else
        ov_opt="ethernet"
      fi
      ;;
    *)
      if printf '%s' "$ov" | grep -qE '^-?[0-9]+$'; then ov_opt="overhead $ov"; else ov_opt="ethernet"; fi
      ;;
  esac
  local opts_out="bandwidth ${up}mbit $ds $nat $ack $ov_opt"
  local opts_in="bandwidth ${dn}mbit $ds $nat $ov_opt"
  [ "$wash" = "1" ] && opts_out="$opts_out wash" && opts_in="$opts_in wash"
  opts_out=$(echo $opts_out)
  opts_in=$(echo $opts_in)
  tc qdisc del dev "$dev" root 2>/dev/null || true
  tc qdisc del dev "$dev" ingress 2>/dev/null || true
  tc qdisc del dev ifb-sqm root 2>/dev/null || true
  ip link add ifb-sqm type ifb 2>/dev/null || true
  ip link set ifb-sqm up || return 1
  if ! tc qdisc replace dev "$dev" root cake $opts_out; then
    tc qdisc replace dev "$dev" root cake bandwidth "${up}mbit" $ds || { rc=$?; tc qdisc del dev "$dev" root 2>/dev/null || true; return $rc; }
  fi
  tc qdisc add dev "$dev" handle ffff: ingress || { rc=$?; tc qdisc del dev "$dev" root 2>/dev/null || true; return $rc; }
  tc filter add dev "$dev" parent ffff: protocol all u32 match u32 0 0 action mirred egress redirect dev ifb-sqm || {
    rc=$?
    tc qdisc del dev "$dev" ingress 2>/dev/null || true
    tc qdisc del dev "$dev" root 2>/dev/null || true
    tc qdisc del dev ifb-sqm root 2>/dev/null || true
    return $rc
  }
  if ! tc qdisc replace dev ifb-sqm root cake $opts_in; then
    tc qdisc replace dev ifb-sqm root cake bandwidth "${dn}mbit" $ds || {
      rc=$?
      tc qdisc del dev "$dev" ingress 2>/dev/null || true
      tc qdisc del dev "$dev" root 2>/dev/null || true
      tc qdisc del dev ifb-sqm root 2>/dev/null || true
      return $rc
    }
  fi
  local tc_diag
  if ! tc_diag=$(sqm_tc_probe "$dev"); then
    echo "SQM: tc post-apply incompleto: $tc_diag" >&2
    tc qdisc del dev "$dev" ingress 2>/dev/null || true
    tc qdisc del dev "$dev" root 2>/dev/null || true
    tc qdisc del dev ifb-sqm root 2>/dev/null || true
    return 1
  fi
  echo "SQM CAKE $dev up=${up}mbit down=${dn}mbit $ds $ack framing=$ov ($ov_opt)"
}

# Read-only, format-tolerant verification of all three pieces required for
# IPTM's CAKE shaping. Never infer an unshaped connection from a failed tc read.
# The filter action may be split over several output lines by iproute2.
sqm_tc_probe() {
  local dev="$1" wan_q="" ifb_q="" flt="" flat="" rc
  local wan_root=unknown ingress=unknown ifb_root=unknown redirect=unknown
  if wan_q=$(tc qdisc show dev "$dev" 2>&1); then
    if printf '%s\n' "$wan_q" | grep -Eq '^qdisc[[:space:]]+cake[[:space:]].*[[:space:]]root([[:space:]]|$)'; then
      wan_root=ok
    elif printf '%s\n' "$wan_q" | grep -Eq '^qdisc[[:space:]]+[^[:space:]]+[[:space:]].*[[:space:]]root([[:space:]]|$)'; then
      wan_root=other-qdisc
    else
      wan_root=missing
    fi
    if printf '%s\n' "$wan_q" | grep -Eq '^qdisc[[:space:]]+(ingress|clsact)[[:space:]]'; then
      ingress=ok
    else
      ingress=missing
    fi
  else
    wan_root=read-error; ingress=read-error
  fi
  if ifb_q=$(tc qdisc show dev ifb-sqm 2>&1); then
    if printf '%s\n' "$ifb_q" | grep -Eq '^qdisc[[:space:]]+cake[[:space:]].*[[:space:]]root([[:space:]]|$)'; then
      ifb_root=ok
    else
      ifb_root=missing
    fi
  else
    ifb_root=read-error
  fi
  if flt=$(tc filter show dev "$dev" parent ffff: 2>&1); then
    # A bounded match across line breaks; insist on REDIRECT, not mirroring.
    flat=$(printf '%s' "$flt" | tr '\r\n' '  ')
    if printf '%s\n' "$flat" | grep -Eiq 'mirred.{0,160}redirect.{0,160}ifb-sqm'; then
      redirect=ok
    else
      # Some iproute2 builds wrap actions with verbose counters between
      # 'mirred', 'redirect' and the IFB name. Prefer its structured JSON when
      # available; do NOT assume a redirect exists just because IFB is up.
      local filter_json=""
      if filter_json=$(tc -j filter show dev "$dev" parent ffff: 2>/dev/null); then
        if printf '%s' "$filter_json" | python3 -c '
import json,sys
try: data=json.load(sys.stdin)
except (ValueError,UnicodeError): sys.exit(1)
def walk(obj):
    if isinstance(obj,list):
        return any(walk(item) for item in obj)
    if not isinstance(obj,dict): return False
    typ=str(obj.get("kind",obj.get("type",""))).lower()
    act=str(obj.get("eaction",obj.get("action",""))).lower()
    target=str(obj.get("to_dev",obj.get("dev",""))).lower()
    if typ=="mirred" and ("redirect" in act) and target=="ifb-sqm":
        return True
    return any(walk(v) for v in obj.values() if isinstance(v,(dict,list)))
sys.exit(0 if walk(data) else 1)
' 2>/dev/null; then redirect=ok; else redirect=missing; fi
      else
        redirect=missing
      fi
    fi
  else
    redirect=read-error
  fi
  printf 'wan_root=%s ingress=%s ifb_root=%s redirect=%s\n' \
    "$wan_root" "$ingress" "$ifb_root" "$redirect"
  [[ "$wan_root" == ok && "$ingress" == ok && "$ifb_root" == ok && "$redirect" == ok ]]
}


# Rate-only CAKE update. Keep WAN ingress, mirred redirect, and IFB intact;
# never remove/re-create an active qdisc to explore available bandwidth.
sqm_cake_rate() { # dev -> integer Mbit/s; a missing/ambiguous rate is an error
  local listing line amount unit
  listing=$(tc qdisc show dev "$1" 2>/dev/null) || return 1
  line=$(printf '%s\n' "$listing" | awk '$1=="qdisc" && $2=="cake" && / root / {print;exit}')
  [[ "$line" =~ (^|[[:space:]])bandwidth[[:space:]]+([0-9]+)(Kbit|Mbit|Gbit)([[:space:]]|$) ]] || return 1
  amount="${BASH_REMATCH[2]}" unit="${BASH_REMATCH[3]}"
  case "$unit" in Mbit) printf '%s\n' "$amount";; Gbit) echo $((amount*1000));; Kbit) [ $((amount%1000)) -eq 0 ] || return 1; echo $((amount/1000));; esac
}
sqm_rates_match() { # dev up down
  local live_up live_down
  live_up=$(sqm_cake_rate "$1") || return 1
  live_down=$(sqm_cake_rate ifb-sqm) || return 1
  [ "$live_up" -eq "$2" ] && [ "$live_down" -eq "$3" ]
}
sqm_rate_change() { # dev up down; only an existing verified managed CAKE topology
  local iface="$1" up="$2" down="$3" ds ack nat ov wash
  [[ "$iface" =~ ^[A-Za-z0-9_.-]{1,15}$ && "$up" =~ ^[0-9]{1,6}$ && "$down" =~ ^[0-9]{1,6}$ ]] || return 2
  [ "$up" -ge 1 ] && [ "$down" -ge 1 ] || return 2
  sqm_tc_probe "$iface" >/dev/null || return 68
  ds="${SQM_DIFFSERV:-diffserv4}"; case "$ds" in besteffort|diffserv3|diffserv4|diffserv8) ;; *) return 2;; esac
  case "${SQM_ACK:-1}" in 1|ack-filter) ack=ack-filter;; 0|no-ack-filter) ack=no-ack-filter;; *) return 2;; esac
  case "${SQM_NAT:-1}" in 1|nat) nat=nat;; 0|nonat) nat=nonat;; *) return 2;; esac
  wash=(); [ "${SQM_WASH:-0}" = 1 ] && wash=(wash)
  ov=(); case "${SQM_OVERHEAD:-ethernet}" in
    none) ;; ethernet) ov=(ethernet);; pppoe-v4) ov=(overhead 40);;
    pppoe-ptm) ov=(overhead 30);; bridged-ptm) ov=(overhead 22);;
    conservative) ov=(overhead 48);; *) return 2;; esac
  tc qdisc change dev "$iface" root cake bandwidth "${up}mbit" "$ds" "$nat" "$ack" "${ov[@]}" "${wash[@]}" || return 1
  tc qdisc change dev ifb-sqm root cake bandwidth "${down}mbit" "$ds" "$nat" "${ov[@]}" "${wash[@]}" || return 1
  sqm_tc_probe "$iface" >/dev/null && sqm_rates_match "$iface" "$up" "$down"
}
# Persistent timer watchdog: even a killed speedtest cannot leave temporary
# elevated rates indefinitely. Abort active exploration if systemd-run fails.
# QoS candidate transaction: prepare -> validate -> timed rollback unless confirmed.
# The on-disk profile stays unchanged until confirmation. This is the same
# commit-confirm principle used by mature firewall platforms, with ownership
# checks before *every* tc mutation. Independent of the HTTP/PHP process.
sqm_safe_path() { printf '%s\n' /run/iptm-sqm-safe/active; }
# Prevent another SQM worker from replacing an unconfirmed recovery qdisc.
# Fails closed on malformed/symlinked state; only reconcile rollback may proceed.
sqm_reconcile_pending() {
  local f=/var/lib/iptm-sqm-reconcile/state.json
  [ ! -L "$f" ] || return 0
  [ -f "$f" ] || return 1
  grep -Eq '"status"[[:space:]]*:[[:space:]]*"(pending|rollback-incomplete)"' "$f" ||
    { grep -q '"status"' "$f" || return 0; return 1; }
}
sqm_reconcile_assert_idle() {
  if sqm_reconcile_pending; then
    echo 'CAKE: ripristino protetto in corso; confermare o annullare sqm-reconcile prima di cambiare QoS' >&2
    exit 75
  fi
}

sqm_safe_read() {
  local file
  file=$(sqm_safe_path)
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  [ "$(stat -c %u "$file" 2>/dev/null)" = 0 ] || return 1
  [ "$(stat -c %a "$file" 2>/dev/null)" = 600 ] || return 1
  safe_token=$(sed -n 's/^token=//p' "$file" | head -n1)
  safe_iface=$(sed -n 's/^iface=//p' "$file" | head -n1)
  safe_expiry=$(sed -n 's/^expiry=//p' "$file" | head -n1)
  safe_up=$(sed -n 's/^new_up=//p' "$file" | head -n1)
  safe_down=$(sed -n 's/^new_down=//p' "$file" | head -n1)
  safe_ds=$(sed -n 's/^new_ds=//p' "$file" | head -n1)
  safe_ack=$(sed -n 's/^new_ack=//p' "$file" | head -n1)
  safe_nat=$(sed -n 's/^new_nat=//p' "$file" | head -n1)
  safe_overhead=$(sed -n 's/^new_overhead=//p' "$file" | head -n1)
  safe_wash=$(sed -n 's/^new_wash=//p' "$file" | head -n1)
  safe_old_up=$(sed -n 's/^old_up=//p' "$file" | head -n1)
  safe_old_down=$(sed -n 's/^old_down=//p' "$file" | head -n1)
  [[ "$safe_token" =~ ^[0-9a-f]{24}$ && "$safe_iface" =~ ^[A-Za-z0-9_.-]{1,15}$ &&
     "$safe_expiry" =~ ^[0-9]{10,11}$ && "$safe_up" =~ ^[0-9]{1,6}$ &&
     "$safe_down" =~ ^[0-9]{1,6}$ && "$safe_old_up" =~ ^[0-9]{1,6}$ &&
     "$safe_old_down" =~ ^[0-9]{1,6}$ &&
     "$safe_ds" =~ ^(besteffort|diffserv3|diffserv4|diffserv8)$ &&
     "$safe_ack" =~ ^[01]$ && "$safe_nat" =~ ^[01]$ && "$safe_wash" =~ ^[01]$ &&
     "$safe_overhead" =~ ^(none|ethernet|pppoe-v4|pppoe-ptm|bridged-ptm|conservative)$ ]] || return 1
}
sqm_safe_end_timer() {
  systemctl stop "iptm-sqm-safe-$safe_token.timer" >/dev/null 2>&1 || true
}
sqm_safe_revert_locked() {
  local file diag
  file=$(sqm_safe_path)
  # Only undo the topology IPTM prepared, at exactly the expected rates.
  if [ "${SQM_IF:-}" != '' ] && [ "$safe_iface" != "$SQM_IF" ]; then
    echo 'CRITICO: rollback QoS: interfaccia salvata diversa; nessuna mutazione' >&2; return 70
  fi
  # Crash boundary: if the administrator already confirmed, the atomic
  # config commit may have completed just before the worker was killed while
  # removing its watchdog. Never undo a profile already durably committed.
  # Compare the FULL saved candidate, not only the rates.
  local committed_ack committed_nat
  case "${SQM_ACK:-1}" in 1|ack-filter) committed_ack=1;; *) committed_ack=0;; esac
  case "${SQM_NAT:-1}" in 1|nat) committed_nat=1;; *) committed_nat=0;; esac
  if [ "${SQM_IF:-}" = "$safe_iface" ] && [ "${SQM_UP:-0}" = "$safe_up" ] &&
     [ "${SQM_DOWN:-0}" = "$safe_down" ] &&
     [ "${SQM_DIFFSERV:-diffserv4}" = "$safe_ds" ] &&
     [ "$committed_ack" = "$safe_ack" ] && [ "$committed_nat" = "$safe_nat" ] &&
     [ "${SQM_OVERHEAD:-ethernet}" = "$safe_overhead" ] &&
     [ "${SQM_WASH:-0}" = "$safe_wash" ]; then
    if sqm_tc_probe "$safe_iface" >/dev/null && sqm_rates_match "$safe_iface" "$safe_up" "$safe_down"; then
      rm -f -- "$file" || return 70
      sqm_safe_end_timer
      echo 'ok QoS: candidato già confermato e verificato; watchdog ritirato'; return 0
    fi
    echo 'CRITICO: profilo QoS salvato ma stato CAKE non verificato' >&2; return 70
  fi
  if [ "$safe_old_up" -eq 0 ] && [ "$safe_old_down" -eq 0 ]; then
    # A crash could happen after guard arming but *before* the first tc
    # mutation. If the WAN is still unshaped and no IFB redirect exists,
    # simply retire the guard instead of reporting a false critical failure.
    local root_kind
    root_kind=$(tc qdisc show dev "$safe_iface" 2>/dev/null | awk '$1=="qdisc" && / root / {print $2;exit}') || return 70
    case "$root_kind" in ''|fq_codel|noqueue|mq)
      if ! tc qdisc show dev "$safe_iface" 2>/dev/null | grep -Eq '^qdisc (ingress|clsact) ' &&
         ! tc qdisc show dev ifb-sqm 2>/dev/null | grep -qE '^qdisc cake '; then
        rm -f -- "$file" || return 70
        sqm_safe_end_timer
        echo 'ok QoS: prova annullata prima della modifica live'; return 0
      fi;;
    esac
  fi
  local original_ack original_nat original_profile_same=0
  case "${SQM_ACK:-1}" in 1|ack-filter) original_ack=1;; *) original_ack=0;; esac
  case "${SQM_NAT:-1}" in 1|nat) original_nat=1;; *) original_nat=0;; esac
  if [ "${SQM_DIFFSERV:-diffserv4}" = "$safe_ds" ] &&
     [ "$original_ack" = "$safe_ack" ] && [ "$original_nat" = "$safe_nat" ] &&
     [ "${SQM_OVERHEAD:-ethernet}" = "$safe_overhead" ] && [ "${SQM_WASH:-0}" = "$safe_wash" ]; then
    original_profile_same=1
  fi
  if [ "$original_profile_same" = 1 ] &&
     sqm_rates_match "$safe_iface" "$safe_old_up" "$safe_old_down" 2>/dev/null &&
     [ "$safe_old_up" -gt 0 ] && [ "$safe_old_down" -gt 0 ]; then
    : # old rates and unchanged options, already restored by earlier worker
  else
    diag=$(sqm_tc_probe "$safe_iface") || { echo "CRITICO: rollback QoS rifiutato ($diag)" >&2; return 70; }
    sqm_rates_match "$safe_iface" "$safe_up" "$safe_down" || {
      echo 'CRITICO: rollback QoS: qdisc modificata da terzi' >&2; return 70;
    }
    if [ "$safe_old_up" -gt 0 ] && [ "$safe_old_down" -gt 0 ]; then
      sqm_rate_change "$safe_iface" "$safe_old_up" "$safe_old_down" || {
        echo 'CRITICO: ripristino rate precedente fallito; watchdog conservato' >&2; return 70;
      }
    else
      # The original state was kernel default/no IPTM qdisc. Only remove the
      # verified candidate that IPTM itself installed, not unrelated filters.
      tc qdisc del dev "$safe_iface" ingress || return 70
      tc qdisc del dev "$safe_iface" root || return 70
      tc qdisc del dev ifb-sqm root || return 70
    fi
  fi
  rm -f -- "$file" || return 70
  sqm_safe_end_timer
  echo 'ok QoS profilo precedente ripristinato; nessun commit'
}
sqm_safe_status() {
  if [ -e "$(sqm_safe_path)" ] || [ -L "$(sqm_safe_path)" ]; then
    if ! sqm_safe_read; then echo 'state=unsafe'; return 70; fi
    local remain=$((safe_expiry-$(date +%s)))
    [ "$remain" -ge 0 ] || remain=0
    printf 'state=pending\ntoken=%s\nseconds_left=%s\niface=%s\nnew_down=%s\nnew_up=%s\nold_down=%s\nold_up=%s\nnew_diffserv=%s\nnew_ack=%s\nnew_nat=%s\nnew_overhead=%s\nnew_wash=%s\n' \
      "$safe_token" "$remain" "$safe_iface" "$safe_down" "$safe_up" "$safe_old_down" "$safe_old_up" \
      "$safe_ds" "$safe_ack" "$safe_nat" "$safe_overhead" "$safe_wash"
  else
    echo 'state=idle'
  fi
}

sqm_probe_guard_path() { echo /run/iptm-sqm-probe/active; }
sqm_probe_arm() { # iface original-up original-down temporary-up temporary-down
  local iface="$1" old_up="$2" old_down="$3" probe_up="$4" probe_down="$5" tx f t
  command -v systemd-run >/dev/null 2>&1 || return 1
  mkdir -p -m 0700 /run/iptm-sqm-probe || return 1
  chmod 0700 /run/iptm-sqm-probe || return 1
  f=$(sqm_probe_guard_path)
  [ ! -e "$f" ] && [ ! -L "$f" ] || { echo 'SQM: precedente prova pendente, rifiuto di una nuova' >&2; return 1; }
  tx=$(python3 -c 'import secrets;print(secrets.token_hex(12))') || return 1
  t=$(mktemp /run/iptm-sqm-probe/.state.XXXXXXXX) || return 1
  chmod 0600 "$t" || { rm -f "$t"; return 1; }
  printf 'token=%s\niface=%s\nold_up=%s\nold_down=%s\nprobe_up=%s\nprobe_down=%s\n' \
    "$tx" "$iface" "$old_up" "$old_down" "$probe_up" "$probe_down" > "$t" || { rm -f "$t"; return 1; }
  mv -f "$t" "$f" || { rm -f "$t"; return 1; }
  if ! systemd-run --quiet --unit="iptm-sqm-probe-$tx" --on-active=300s \
      /bin/bash /usr/local/sbin/iptm-helper sqm-probe-restore "$tx" ||
     ! systemctl is-active --quiet "iptm-sqm-probe-$tx.timer"; then
    systemctl stop "iptm-sqm-probe-$tx.timer" >/dev/null 2>&1 || true
    rm -f "$f"; echo 'SQM: watchdog systemd non attivo, nessuna modifica tc' >&2; return 1
  fi
  SQM_PROBE_TX="$tx" SQM_PROBE_ACTIVE=1
}
sqm_probe_cleanup() { # restore previous speed after an active probe
  [ "${SQM_PROBE_ACTIVE:-0}" = 1 ] || return 0
  if ! sqm_rate_change "$wan" "$local_up" "$local_down"; then
    echo 'SQM CRITICO: ripristino rate temporanei fallito; watchdog armato' >&2
    return 70
  fi
  SQM_PROBE_ACTIVE=0
  [ -f "$(sqm_probe_guard_path)" ] && rm -f "$(sqm_probe_guard_path)"
  # Stopping the timer is optional; an already fired guard sees no active token.
  [ -n "${SQM_PROBE_TX:-}" ] && systemctl stop "iptm-sqm-probe-$SQM_PROBE_TX.timer" >/dev/null 2>&1 || true
  return 0
}
# Bounded, atomic, readable QoS decision journal. Entries contain only
# controlled status codes and integer measurements, never commands or tokens.
sqm_history() { # event [detail]; failures never change CAKE behaviour
  local event="${1:-unknown}" details="${2:-}" d
  [[ "$event" =~ ^[a-z0-9-]{1,40}$ ]] || return 1
  d=$(data_dir) || return 1
  mkdir -p "$d" || return 1
  python3 - "$d/sqm-decisions.log" "$event" "$details" <<'IPTM_SQM_HISTORY'
import os, re, stat, sys, time, tempfile
path, event, details = sys.argv[1:4]
if not re.fullmatch(r'[a-z0-9-]{1,40}', event): sys.exit(1)
details = re.sub(r'[^a-zA-Z0-9_.,:/= %+-]', '_', details)[:180]
try:
    fd_read = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd_read, 'r', encoding='ascii', errors='replace') as old:
        info = os.fstat(old.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > 65536: sys.exit(1)
        lines = old.readlines()[-99:]
except FileNotFoundError:
    lines = []
except OSError:
    sys.exit(1)
fd, temp = tempfile.mkstemp(prefix='.sqm-journal-',dir=os.path.dirname(path))
try:
    with os.fdopen(fd,'w',encoding='ascii') as fp:
        fp.writelines(lines)
        fp.write(f'{int(time.time())}|{event}|{details}\n')
        fp.flush(); os.fsync(fp.fileno())
    os.chmod(temp,0o644)
    os.replace(temp,path)
except Exception:
    try: os.unlink(temp)
    except OSError: pass
    raise
IPTM_SQM_HISTORY
}
sqm_observe() { # reason, always report original limits; never pretend applied
  local reason="$1" t
  t=$(mktemp "$D/.sqm-observation.XXXXXXXX") || return 1
  printf 'mode=observation-only\nmethod=%s\nmeasured_down=%s\nmeasured_up=%s\nconfigured_down=%s\nconfigured_up=%s\niface=%s\nts=%s\nreason=%s\nprobe=%s\n' \
    "${method:-none}" "${down:-0}" "${up:-0}" "${local_down:-0}" "${local_up:-0}" "$wan" "$(date +%s)" "$reason" "${probe_used:-0}" > "$t"
  if [ "$reason" = incomplete ]; then
    printf 'detail=%s\n' "${failure_code:-unknown}" >> "$t"
  fi
  chmod 0644 "$t" && mv -f "$t" "$D/sqm-autocal-observation.last"
  sqm_history "$reason" "measured=${down:-0}/${up:-0} kept=${local_down:-0}/${local_up:-0} failure=${failure_code:-none}" || true
}
# Synchronize only SQM rates after a successful helper commit. Same settings.lock
# as PHP; compare the previous values before modifying to avoid stale writes.
sqm_sync_json_rates() { # iface old_up old_down new_up new_down
  local d
  d=$(data_dir)
  python3 - "$d" "$1" "$2" "$3" "$4" "$5" <<'IPTM_SQM_SYNC_JSON'
import fcntl,json,os,pathlib,stat,sys,tempfile,time
base=pathlib.Path(sys.argv[1]); iface=sys.argv[2]
old_up,old_down,new_up,new_down=map(int,sys.argv[3:])
path=base/'settings.json'; lock=base/'settings.lock'
try:
 if not path.is_file() or path.is_symlink() or not lock.is_file() or lock.is_symlink(): raise ValueError('settings missing or unsafe')
 with open(lock,'r+b') as l:
  fcntl.flock(l,fcntl.LOCK_EX)
  st=path.stat()
  if not stat.S_ISREG(st.st_mode): raise ValueError('not regular')
  data=json.loads(path.read_text(encoding='utf-8'))
  q=data.get('sqm')
  if not isinstance(q,dict) or int(q.get('up',-1))!=old_up or int(q.get('down',-1))!=old_down:
   raise ValueError('settings changed during test')
  if q.get('iface')!=iface:
   if old_up==0 and old_down==0 and q.get('iface') in ('',None): q['iface']=iface
   else: raise ValueError('settings interface changed during test')
  # Match the existing PHP settings_snapshot behavior: back up the full
  # pre-change JSON (may contain credentials) with mode 0600 before replacing.
  raw=path.read_bytes()
  backup=base/'backups'
  if backup.is_symlink(): raise ValueError('backup dir is symlink')
  backup.mkdir(mode=0o700,exist_ok=True)
  if not backup.is_dir(): raise ValueError('backup path invalid')
  fd_b,backup_tmp=tempfile.mkstemp(prefix='.sqm-snapshot-',dir=backup)
  backup_name=backup/('settings.'+time.strftime('%Y%m%d-%H%M%S')+'-sqm-'+os.urandom(5).hex()+'.json')
  try:
   with os.fdopen(fd_b,'wb') as b:
    os.fchmod(b.fileno(),0o600)
    b.write(raw);b.flush();os.fsync(b.fileno())
   os.replace(backup_tmp,backup_name)
  finally:
   if os.path.exists(backup_tmp):os.unlink(backup_tmp)
  q.update(up=new_up,down=new_down,on=1,last_cal=int(time.time()))
  payload=json.dumps(data,ensure_ascii=False,indent=4).encode('utf-8')
  fd,tmp=tempfile.mkstemp(prefix='.sqm-settings-',dir=base)
  try:
   with os.fdopen(fd,'wb') as h: h.write(payload); h.flush(); os.fsync(h.fileno())
   os.chmod(tmp,stat.S_IMODE(st.st_mode))
   os.chown(tmp,st.st_uid,st.st_gid)
   os.replace(tmp,path)
   # settings.prev.json stays available; cap automatic settings archives at 10.
   entries=[]
   for item in backup.iterdir():
    if not item.name.startswith('settings.') or not item.name.endswith('.json') or item.is_symlink():continue
    try:
     ist=item.stat(follow_symlinks=False)
     if stat.S_ISREG(ist.st_mode):entries.append((ist.st_mtime_ns,item.name,ist.st_ino))
    except OSError:pass
   entries.sort(reverse=True)
   for _,name,ino in entries[10:]:
    older=backup/name
    try:
     ist=older.lstat()
     if ist.st_ino==ino and stat.S_ISREG(ist.st_mode):older.unlink()
    except OSError:pass
  finally:
   if os.path.exists(tmp): os.unlink(tmp)
except (OSError,ValueError,TypeError,KeyError,json.JSONDecodeError) as exc:
 print('SQM: sincronizzazione settings.json differita ('+str(exc)[:120]+')',file=sys.stderr)
IPTM_SQM_SYNC_JSON
}

# Safety boundary for tc: refuse unmanaged root/ingress. Restore IPTM-managed
# CAKE if a later command fails; never report a partial application as success.
sqm_apply() {
  local dev="$1" up="$2" dn="$3" listing kind previous=0 rv=0
  [[ "$dev" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] && [[ "$up" =~ ^[0-9]{1,6}$ ]] && [[ "$dn" =~ ^[0-9]{1,6}$ ]] &&
    [ "$up" -gt 0 ] && [ "$dn" -gt 0 ] || { echo 'SQM: interfaccia o velocita non valida' >&2; return 2; }
  ip link show dev "$dev" >/dev/null 2>&1 || { echo "SQM: interfaccia $dev inesistente" >&2; return 2; }
  if [ -n "${SQM_IF:-}" ] && [ "$SQM_IF" != "$dev" ]; then
    echo "SQM: cambio interfaccia rifiutato: disabilitare prima il profilo su $SQM_IF" >&2; return 66
  fi
  listing=$(tc qdisc show dev "$dev" 2>/dev/null) || { echo 'SQM: impossibile leggere qdisc WAN' >&2; return 67; }
  kind=$(printf '%s\n' "$listing" | awk '$1=="qdisc" && / root / {print $2; exit}')
  case "$kind" in
    cake)
      [ "${SQM_IF:-}" = "$dev" ] || { echo 'SQM: CAKE preesistente non gestito: rifiuto sostituzione' >&2; return 68; }
      [ "${SQM_UP:-0}" -gt 0 ] 2>/dev/null && [ "${SQM_DOWN:-0}" -gt 0 ] 2>/dev/null || {
        echo 'SQM: limiti precedenti non noti, ripristino impossibile' >&2; return 68; }
      local tc_diag
      if ! tc_diag=$(sqm_tc_probe "$dev") || ! sqm_rates_match "$dev" "$SQM_UP" "$SQM_DOWN"; then
        echo "SQM: stato CAKE o rate preesistenti incoerenti ($tc_diag); applicazione bloccata" >&2
        return 68
      fi
      previous=1 ;;
    ''|fq_codel|pfifo_fast|noqueue|mq|fq|fq_pie)
      # A configured but missing CAKE root does NOT prove ownership of an
      # existing ingress/IFB. Do not remove another daemon's filters.
      if tc qdisc show dev "$dev" 2>/dev/null | grep -Eq '^qdisc (ingress|clsact) ' ||
         tc qdisc show dev ifb-sqm 2>/dev/null | grep -qE '^qdisc cake '; then
        echo 'SQM: ingress o IFB preesistente senza CAKE root verificata; nessuna modifica' >&2; return 68
      fi ;;
    *) echo "SQM: qdisc $kind non gestita; impossibile garantire il rollback" >&2; return 68 ;;
  esac
  # Any change to an ALREADY MANAGED profile, including diffserv/NAT/ACK/
  # overhead, must be performed in-place. Never delete WAN ingress or IFB
  # simply to change a CAKE option. On any partial failure, restore *both*
  # prior rates AND prior options while ownership remains verified.
  if [ "$previous" -eq 1 ]; then
    if sqm_rate_change "$dev" "$up" "$dn"; then return 0; fi
    local SQM_DIFFSERV="${SQM_PREVIOUS_DIFFSERV:-diffserv4}"
    local SQM_ACK="${SQM_PREVIOUS_ACK:-1}"
    local SQM_NAT="${SQM_PREVIOUS_NAT:-1}"
    local SQM_OVERHEAD="${SQM_PREVIOUS_OVERHEAD:-ethernet}"
    local SQM_WASH="${SQM_PREVIOUS_WASH:-0}"
    if sqm_rate_change "$dev" "$SQM_UP" "$SQM_DOWN"; then
      echo 'SQM: cambio CAKE fallito; rates e opzioni precedenti ripristinati' >&2
      return 1
    fi
    echo 'SQM CRITICO: rollback CAKE in-place fallito, intervento manuale necessario' >&2
    return 70
  fi
  if sqm_apply_raw "$dev" "$up" "$dn"; then return 0; else rv=$?; fi
  [ "$rv" -ne 0 ] || rv=1
  if [ "$previous" -eq 1 ]; then
    # The caller may have changed option environment for a proposed new profile.
    local SQM_DIFFSERV="${SQM_PREVIOUS_DIFFSERV:-diffserv4}"
    local SQM_ACK="${SQM_PREVIOUS_ACK:-ack-filter}"
    local SQM_NAT="${SQM_PREVIOUS_NAT:-nat}"
    local SQM_OVERHEAD="${SQM_PREVIOUS_OVERHEAD:-ethernet}"
    local SQM_WASH="${SQM_PREVIOUS_WASH:-0}"
    case "$SQM_ACK" in 1) SQM_ACK=ack-filter ;; 0) SQM_ACK=no-ack-filter ;; esac
    case "$SQM_NAT" in 1) SQM_NAT=nat ;; 0) SQM_NAT=nonat ;; esac
    if sqm_apply_raw "$dev" "$SQM_UP" "$SQM_DOWN" >/dev/null; then
      echo 'SQM: nuova configurazione fallita; precedente CAKE ripristinata' >&2
    else
      echo 'SQM CRITICO: rollback CAKE fallito, recupero manuale necessario' >&2
      return 70
    fi
  else
    echo 'SQM: configurazione nuova fallita, interfaccia senza CAKE gestito' >&2
  fi
  return "$rv"
}

# Serializza tutte le operazioni sysctl IPTM. Il lock resta aperto attraverso exec,
# così audit e modifiche non osservano/sovrascrivono transazioni intermedie.
if [ "${IPTM_SYSCTL_LOCKED:-0}" != "1" ]; then
  case "${1:-}" in
    sysctl-audit)
      mkdir -p /run/lock
      exec 9>/run/lock/iptm-sysctl.lock
      flock -s 9 || exit 1
      export IPTM_SYSCTL_LOCKED=1
      exec "$0" "$@"
      ;;
    sysctl-set)
      mkdir -p /run/lock
      exec 9>/run/lock/iptm-sysctl.lock
      flock -x 9 || exit 1
      export IPTM_SYSCTL_LOCKED=1
      exec "$0" "$@"
      ;;
  esac
fi


