# Transactional local.rules editor. A failed -T restores BOTH the rule file
# and a modified suricata.yaml; otherwise a bad edit can silently take effect
# on the next service restart. Independent of service reload policy.
su_local_rules_write() {  # directory / path-local.rules / yaml / suricata-bin (data on stdin)
  local dir="$1" loc="$2" yaml="$3" binary="$4" tmp_rule='' tmp_yaml=''
  local bak_rule='' bak_yaml='' yaml_changed=0 had_rule=0 test_output='' rc=0
  [ -n "$binary" ] && [ -x "$binary" ] && [ -f "$yaml" ] && [ ! -L "$yaml" ] || {
    echo 'Suricata: configurazione o validatore -T non disponibile, nessuna modifica' >&2; return 1;
  }
  [ -d "$dir" ] && [ ! -L "$dir" ] || { echo 'Directory regole non sicura' >&2; return 1; }
  [ ! -L "$loc" ] && { [ ! -e "$loc" ] || [ -f "$loc" ]; } || {
    echo 'local.rules non regolare o symlink: nessuna modifica' >&2; return 1;
  }
  tmp_rule=$(mktemp "$dir/.iptm-rules-new.XXXXXXXX") || return 1
  if ! cat > "$tmp_rule" || [ "$(wc -c < "$tmp_rule")" -gt 200000 ]; then
    rm -f -- "$tmp_rule"; echo 'Regole Suricata non leggibili o oltre 200 KB' >&2; return 1
  fi
  chmod 0644 "$tmp_rule" || { rm -f -- "$tmp_rule"; return 1; }
  bak_rule=$(mktemp "$dir/.iptm-rules-old.XXXXXXXX") || { rm -f -- "$tmp_rule"; return 1; }
  if [ -f "$loc" ]; then
    had_rule=1
    cp -p -- "$loc" "$bak_rule" || { rm -f -- "$tmp_rule" "$bak_rule"; return 1; }
  fi
  # Modify YAML only if its rule-files list does not already mention local.rules.
  if ! grep -Eq '^[[:space:]]*-[[:space:]]*local[.]rules([[:space:]#]|$)' "$yaml"; then
    if ! grep -Eq '^rule-files:[[:space:]]*($|#)' "$yaml"; then
      rm -f -- "$tmp_rule" "$bak_rule"
      echo 'Suricata: sezione rule-files mancante/non standard; aggiornare YAML manualmente' >&2
      return 1
    fi
    tmp_yaml=$(mktemp "$(dirname "$yaml")/.iptm-yaml-new.XXXXXXXX") || { rm -f -- "$tmp_rule" "$bak_rule"; return 1; }
    bak_yaml=$(mktemp "$(dirname "$yaml")/.iptm-yaml-old.XXXXXXXX") || { rm -f -- "$tmp_rule" "$bak_rule" "$tmp_yaml"; return 1; }
    cp -p -- "$yaml" "$bak_yaml" || { rm -f -- "$tmp_rule" "$bak_rule" "$tmp_yaml" "$bak_yaml"; return 1; }
    awk '/^rule-files:[[:space:]]*($|#)/{print;print "  - local.rules";next} {print}' "$yaml" > "$tmp_yaml" || {
      rm -f -- "$tmp_rule" "$bak_rule" "$tmp_yaml" "$bak_yaml"; return 1;
    }
    chmod --reference="$yaml" "$tmp_yaml" || { rm -f -- "$tmp_rule" "$bak_rule" "$tmp_yaml" "$bak_yaml"; return 1; }
    chown --reference="$yaml" "$tmp_yaml" || { rm -f -- "$tmp_rule" "$bak_rule" "$tmp_yaml" "$bak_yaml"; return 1; }
    yaml_changed=1
  fi
  if ! mv -f -- "$tmp_rule" "$loc"; then
    rm -f -- "$tmp_rule" "$bak_rule" "$tmp_yaml" "$bak_yaml"
    echo 'Suricata: scrittura regole fallita, nessuna modifica YAML' >&2; return 1
  fi
  if [ "$yaml_changed" -eq 1 ]; then
    if ! mv -f -- "$tmp_yaml" "$yaml"; then rc=1; fi
  fi
  if [ "$rc" -eq 0 ]; then
    test_output=$(timeout -k 5 120 "$binary" -T -c "$yaml" 2>&1) || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    local rollback=0
    if [ "$had_rule" -eq 1 ]; then mv -f -- "$bak_rule" "$loc" || rollback=1
    else rm -f -- "$loc" || rollback=1; fi
    if [ "$yaml_changed" -eq 1 ]; then mv -f -- "$bak_yaml" "$yaml" || rollback=1; fi
    rm -f -- "$tmp_rule" "$tmp_yaml" "$bak_rule" "$bak_yaml"
    if [ "$rollback" -ne 0 ]; then
      echo 'Suricata CRITICO: test negativo e rollback non completo' >&2
    else
      echo 'Suricata: test -T fallito, local.rules e YAML ripristinati' >&2
    fi
    printf '%s\n' "$test_output" | tail -n 12 >&2
    return 1
  fi
  rm -f -- "$bak_rule" "$bak_yaml"
  printf 'local.rules validato e salvato (%s, %s righe)\n' "$loc" "$(wc -l < "$loc")"
  return 0
}
