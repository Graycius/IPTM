# P6 RC6: capture and validate a single IPv6 kernel state at both ends of
# an update. Unknown is NEVER interpreted as disabled. This prevents the old
# false rollback when the first read defaulted to "1" and the second to "unknown".
fw_ipv6_state() {
  local conf=/proc/sys/net/ipv6/conf file v saw=0 enabled=0
  if [ ! -d "$conf" ]; then
    if [ ! -e /proc/net/if_inet6 ] || [ ! -s /proc/net/if_inet6 ]; then
      printf 'disabled\n'
      return 0
    fi
    printf 'unknown\n'
    return 1
  fi
  [ -r "$conf/all/disable_ipv6" ] && [ -r "$conf/default/disable_ipv6" ] || {
    printf 'unknown\n'
    return 1
  }
  for file in "$conf"/*/disable_ipv6; do
    [ -f "$file" ] || continue
    v=$(cat -- "$file" 2>/dev/null) || { printf 'unknown\n'; return 1; }
    case "$v" in
      0) enabled=1 ;;
      1) ;;
      *) printf 'unknown\n'; return 1 ;;
    esac
    saw=1
  done
  [ "$saw" -eq 1 ] || { printf 'unknown\n'; return 1; }
  if [ "$enabled" -eq 1 ] || [ -s /proc/net/if_inet6 ]; then
    printf 'enabled\n'
  else
    printf 'disabled\n'
  fi
}

fw_guard_save() {   # $1=directory: verified snapshot BEFORE any update
  local d="$1" v6_state count4 count6 policy
  mkdir -p "$d" && chmod 700 "$d" || return 1
  if ! iptables-save > "$d/live.v4" 2>"$d/error.v4" ||
     ! grep -qxF '*filter' "$d/live.v4" ||
     ! grep -qxF 'COMMIT' "$d/live.v4"; then
    echo 'IPTM update: backup IPv4 incompleto o non leggibile: aggiornamento annullato prima delle modifiche' >&2
    return 1
  fi
  v6_state=$(fw_ipv6_state) || {
    echo 'IPTM update: stato IPv6 non determinabile dal kernel; nessun file aggiornato. Verificare /proc/sys/net/ipv6/conf/*/disable_ipv6' >&2
    return 1
  }
  case "$v6_state" in enabled|disabled) ;; *)
    echo 'IPTM update: stato IPv6 non valido; nessun file aggiornato' >&2; return 1 ;;
  esac
  printf '%s\n' "$v6_state" > "$d/v6.state" || return 1
  if [ "$v6_state" = enabled ]; then
    command -v ip6tables-save >/dev/null 2>&1 || {
      echo 'IPTM update: IPv6 attivo, ma ip6tables-save non è disponibile' >&2; return 1;
    }
    if ! ip6tables-save > "$d/live.v6" 2>"$d/error.v6" ||
       ! grep -qxF '*filter' "$d/live.v6" ||
       ! grep -qxF 'COMMIT' "$d/live.v6"; then
      echo 'IPTM update: IPv6 attivo, snapshot ip6tables incompleto; aggiornamento annullato' >&2
      return 1
    fi
  else
    # IPv6 really disabled: there is no IPv6 firewall to snapshot.
    : > "$d/live.v6" || return 1
  fi
  if command -v ipset >/dev/null 2>&1; then
    ipset save > "$d/live.ipset" 2>"$d/error.ipset" || {
      echo 'IPTM update: backup ipset fallito' >&2; return 1;
    }
  fi
  count4=$(grep -c '^-A ' "$d/live.v4") || true
  count6=0
  if [ "$v6_state" = enabled ]; then
    count6=$(grep -c '^-A ' "$d/live.v6") || true
  fi
  policy=$(awk '/^\*/{f=($0=="*filter")} f && /^:INPUT /{print $2; exit}' "$d/live.v4")
  [[ "$policy" =~ ^(ACCEPT|DROP|REJECT)$ ]] || {
    echo 'IPTM update: policy INPUT non disponibile nello snapshot IPv4' >&2; return 1;
  }
  printf '%s %s\n' "$((count4+count6))" "$policy" > "$d/meta" || return 1
