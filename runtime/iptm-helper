  [ ! -e "$dest" ] && [ ! -L "$dest" ] || { echo 'Snapshot con questa etichetta già presente' >&2; return 1; }
  tmp=$(mktemp -d "$parent/.pre-update.XXXXXXXX") || return 1
  chmod 0700 "$tmp" || { rm -rf -- "$tmp"; return 1; }
  for file in "$1"/*.json "$1"/*.rules "$CONF" "$WEBCONF"; do
    [ -e "$file" ] || continue
    if [ ! -f "$file" ] || [ -L "$file" ] || ! cp -a -- "$file" "$tmp/"; then
      rm -rf -- "$tmp"; echo "Snapshot: impossibile copiare $file" >&2; return 1
    fi
    count=$((count+1))
  done
  [ "$count" -gt 0 ] || { rm -rf -- "$tmp"; echo 'Nessuna configurazione da salvare prima dell aggiornamento' >&2; return 1; }
