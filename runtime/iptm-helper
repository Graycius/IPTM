}
saved_pol() { awk -v t="$2" '/^\*/{f=($0=="*" t)} f && /^:INPUT /{print $2; exit}' "$1" 2>/dev/null; }   # policy INPUT della tabella filter nel file salvato
fw_unhealthy() {   # return 0=needs recovery, 1=healthy, 2=unknown/unreadable (FAIL CLOSED)
  local n0 p0 n1 p1 live
  [ -s "$1" ] || { echo 'IPTM guard: file regole salvate vuoto' >&2; return 2; }
  if ! grep -qxF '*filter' "$1" || ! grep -qxF 'COMMIT' "$1"; then
