                sqm_rate_change "$wan" "$local_up" "$local_down" >/dev/null || { echo 'SQM CRITICO: rollback rate-only fallito' >&2; exit 70; }
                echo 'err final-rate-change-failed (previous rates restored)' >&2; exit 1
              fi
