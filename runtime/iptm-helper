                raise ValueError(f'linea {lineno}: intervallo QoS fuori limite (15-1440 minuti)')
            if key in {'SQM_UP','SQM_DOWN'} and not re.fullmatch(r'[0-9]{0,6}',val):
                raise ValueError(f'linea {lineno}: velocità non valida')
            if key in {'SQM_ACK','SQM_NAT','SQM_WASH','SQM_AUTOCAL'} and val not in ('','0','1'):
                raise ValueError(f'linea {lineno}: toggle non valido')
            if key == 'SQM_IF' and val and not re.fullmatch(r'[a-zA-Z0-9_.-]{1,15}',val):
                raise ValueError(f'linea {lineno}: interfaccia non valida')
            if key == 'BACKEND_WANTED' and val not in ('','legacy','nft'):
                raise ValueError(f'linea {lineno}: backend non valido')
            sys.stdout.buffer.write(key.encode()+b'\0'+val.encode()+b'\0')
except (OSError,ValueError,UnicodeError) as exc:
    print(f'IPTM configurazione rifiutata: {exc}',file=sys.stderr)
    sys.exit(1)
IPTM_CONFIG_DATA
  then rm -f "$tmp"; return 1; fi
  local -a values=()
  mapfile -d '' -t values < "$tmp"
  rm -f "$tmp"
  (( ${#values[@]} % 2 == 0 )) || { echo 'IPTM: coppie di configurazione incomplete' >&2; return 1; }
  for ((ix=0;ix<${#values[@]};ix+=2)); do
    key="${values[ix]}"; value="${values[ix+1]}"
    printf -v "$key" '%s' "$value"
  done
}
# RC8: kernel IPv6 lifecycle, separate from MAC-address device policies.
# Root-only, persistent, timed rollback, with no firewall/backend switching.
# Keep kernel IPv6 recovery inside the privileged helper.
iptm_ipv6_control() {
  python3 - "${BASH_SOURCE[0]}" "$@" <<'IPTM_IPV6_CONTROL_PY'
import base64
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import secrets
import stat
import subprocess
import sys
import time

HELPER = Path(sys.argv[1]).resolve()
ARG = sys.argv[2:]
PROC = Path('/proc/sys/net/ipv6/conf')
IF6 = Path('/proc/net/if_inet6')
CMDLINE = Path('/proc/cmdline')
MODULE = Path('/sys/module/ipv6/parameters/disable')
STATE = Path('/var/lib/iptm/ipv6-control')
PERSIST = Path('/etc/sysctl.d/99-iptm-ipv6.conf')
PENDING = STATE / 'pending.json'
BOOT_UNIT = Path('/etc/systemd/system/iptm-ipv6-recovery.service')


def die(message, status=1):
    print('IPTM IPv6: ' + message, file=sys.stderr)
    raise SystemExit(status)


def read_flags():
    if not PROC.is_dir():
        return None
    flags = {}
    for entry in sorted(PROC.iterdir()):
        if not entry.is_dir():
            continue
        if not re.fullmatch(r'[A-Za-z0-9_.:@-]{1,64}', entry.name):
            die('nome interfaccia IPv6 non gestibile')
        path = entry / 'disable_ipv6'
        if not path.exists():
            die('flag IPv6 non disponibile per ' + entry.name)
        try:
            v = path.read_text().strip()
        except OSError as ex:
            die(f'lettura IPv6 {entry.name}: {ex}')
        if v not in ('0', '1'):
            die('flag IPv6 non valido per ' + entry.name)
        flags[entry.name] = int(v)
    if 'all' not in flags or 'default' not in flags:
        die('mancano i flag IPv6 all/default')
    return flags


def is_boot_disabled():
    try:
        cmdline = CMDLINE.read_text()
    except OSError:
        cmdline = ''
    try:
        module = MODULE.read_text().strip()
    except OSError:
        module = ''
    return bool(re.search(r'(?:^|\s)ipv6.disable=1(?:\s|$)', cmdline)) or module.lower() in ('1', 'y', 'yes', 'true')


def current_state(flags):
    if flags is None:
        return 'disabled-boot' if is_boot_disabled() else 'unknown'
    if all(v == 1 for v in flags.values()):
        try:
            if IF6.exists() and IF6.stat().st_size != 0:
                return 'partial'
        except OSError:
            return 'unknown'
        return 'disabled'
    if all(v == 0 for v in flags.values()):
        return 'enabled'
    return 'partial'


def pending_read():
    if PENDING.is_symlink():
        die('stato pending non sicuro')
    if not PENDING.exists():
        return None
    try:
        data = PENDING.read_bytes()
        if len(data) > 262144:
            die('stato pending troppo grande')
        tx = json.loads(data)
        if not isinstance(tx, dict) or not re.fullmatch('[0-9a-f]{24}', str(tx.get('token', ''))):
            die('stato pending non valido')
        return tx
    except (OSError, ValueError) as ex:
        die(f'lettura stato pending: {ex}')


def ensure_root_state():
    if STATE.is_symlink():
        die('directory IPv6 symlink rifiutata')
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    st = STATE.stat()
    if st.st_uid != 0 or not stat.S_ISDIR(st.st_mode) or (st.st_mode & 0o077):
        die('directory controllo IPv6 deve essere root:0700')


def atomic_write(path, content, mode=0o600):
    if path.is_symlink():
        die(f'percorso symlink rifiutato: {path}')
    temp = path.with_name('.iptm-' + secrets.token_hex(8))
    try:
        fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
        with os.fdopen(fd, 'wb') as fp:
            fp.write(content)
            fp.flush()
            os.fsync(fp.fileno())
        os.replace(temp, path)
        dfd = os.open(str(path.parent), os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def save_pending(tx):
    atomic_write(PENDING, (json.dumps(tx, sort_keys=True) + '\n').encode())


def existing_persistent():
    if PERSIST.is_symlink():
        die('file sysctl IPv6 symlink rifiutato')
    if not PERSIST.exists():
        return None
    st = PERSIST.stat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or (st.st_mode & 0o022):
        die('configurazione IPv6 persistente non sicura')
    data = PERSIST.read_bytes()
    if len(data) > 131072:
        die('configurazione IPv6 persistente troppo grande')
    return base64.b64encode(data).decode()


def check_ipv4_session(ip):
    try:
        address = ipaddress.ip_address(ip)
    except ValueError:
        die('indirizzo di amministrazione non valido')
    if address.version != 4:
        die('Modifica IPv6 da sessione IPv4; la sessione IPv6 perderebbe connettività')


def check_other_firewall_pending():
    # Never change the kernel alongside an IPTM firewall rollback transaction.
    try:
        wc = json.loads(Path('/etc/iptables-manager.web.json').read_text())
    except (OSError, ValueError):
        wc = {}
    d = wc.get('DATA_DIR', '/var/lib/iptables-manager') if isinstance(wc, dict) else ''
    if not isinstance(d, str) or not d.startswith('/') or '..' in d.split('/'):
        die('directory dati firewall non valida')
    if (Path(d) / 'pending.json').exists():
        die('rollback firewall IPTM in sospeso: confermalo prima di modificare IPv6')


def preflight_enable():
    if is_boot_disabled():
        die('IPv6 disabilitato nei parametri di avvio del kernel: riabilitazione runtime impossibile; modifica il boot e riavvia')
    if not PROC.is_dir():
        die('IPv6 non disponibile nel kernel: serve riavvio/modulo IPv6')
    for cmd in (['ip6tables', '-t', 'filter', '-S'], ['ip6tables-save']):
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=8)
        except (OSError, subprocess.TimeoutExpired) as ex:
            die('backend firewall IPv6 non disponibile: ' + str(ex))
        if result.returncode != 0:
            die('backend IPv6 filter non disponibile; impossibile riabilitare in sicurezza: ' + (result.stderr or result.stdout).strip()[:180])
        if cmd[0] == 'ip6tables-save':
            lines = result.stdout.splitlines()
            if '*filter' not in lines or 'COMMIT' not in lines:
                die('snapshot firewall IPv6 incompleto; attivazione negata')
            if not any(re.match(r'^:INPUT (DROP|REJECT) ', line) for line in lines):
                die('policy INPUT IPv6 non restrittiva: prepara prima una policy IPv6 DROP con eccezioni necessarie')


def write_flag(name, value):
    path = PROC / name / 'disable_ipv6'
    if not path.is_file():
        die('flag IPv6 non disponibile: ' + name)
    try:
        path.write_text(str(int(value)) + '\n')
    except OSError as ex:
        die(f'non posso impostare {name}.disable_ipv6: {ex}')


def set_runtime(mode, originals=None):
    if originals is None:
        current = read_flags()
        if current is None:
            die('IPv6 non gestibile via sysctl nel kernel attuale')
        value = 1 if mode == 'disable' else 0
        desired = {name: value for name in current}
    else:
        desired = dict(originals)
        current = read_flags()
        if current is None:
            die('ripristino impossibile: flag IPv6 non disponibili')
        for name in current:
            if name not in desired:
                desired[name] = originals.get('default', 0)
    # all/default and each existing interface; default controls future interfaces.
    for name in ('default', 'all'):
        write_flag(name, desired[name])
    for name in sorted(desired):
        if name in ('all', 'default') or name not in current:
            continue
        write_flag(name, desired[name])
    after = read_flags()
    if after is None or any(after.get(name) != expected for name, expected in desired.items() if name in after):
        die('la lettura di conferma dei flag IPv6 non coincide con la richiesta')
    if originals is None and current_state(after) not in ('disabled' if mode == 'disable' else 'enabled',):
        die('stato IPv6 non coerente dopo applicazione; rollback necessario')


def persistent_write(mode):
    v = 1 if mode == 'disable' else 0
    content = ('# IPTM IPv6 kernel controls: all (current interfaces), default (future interfaces).\n'
               '# Do not use if another network manager overrides disable_ipv6.\n'
               f'net.ipv6.conf.all.disable_ipv6 = {v}\n'
               f'net.ipv6.conf.default.disable_ipv6 = {v}\n'
               f'net.ipv6.conf.*.disable_ipv6 = {v}\n').encode()
    atomic_write(PERSIST, content, 0o644)


def restore_original(tx):
    old = tx.get('persistent_before')
    if old is None:
        if PERSIST.exists():
            PERSIST.unlink()
    else:
        atomic_write(PERSIST, base64.b64decode(old, validate=True), 0o644)
    set_runtime('', tx['flags'])


def install_boot_recovery():
    if BOOT_UNIT.is_symlink():
        die('unità recovery IPv6 non sicura (symlink)')
    contents = (f'[Unit]\nDescription=Ripristino IPv6 IPTM pendente all avvio\n'
                'DefaultDependencies=no\nAfter=local-fs.target systemd-sysctl.service\n'
                'Before=network-pre.target\nWants=network-pre.target\n'
                '[Service]\nType=oneshot\n'
                f'ExecStart={HELPER} ipv6-control rollback\n'
                '[Install]\nWantedBy=sysinit.target\n').replace('\\n','\n')
    atomic_write(BOOT_UNIT, contents.encode(), 0o644)
    try:
        for cmd in (['systemctl', 'daemon-reload'], ['systemctl', 'enable', BOOT_UNIT.name]):
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
            if r.returncode != 0:
                die('impossibile attivare recovery all avvio: ' + (r.stderr or r.stdout).strip()[:180])
    except (OSError, subprocess.TimeoutExpired) as ex:
        die('recovery all avvio non disponibile: ' + str(ex))


def remove_boot_recovery():
    try:
        r = subprocess.run(['systemctl','disable', BOOT_UNIT.name], capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            die('impossibile disattivare recovery all avvio: ' + (r.stderr or r.stdout).strip()[:180])
        BOOT_UNIT.unlink(missing_ok=True)
        subprocess.run(['systemctl', 'daemon-reload'], capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as ex:
        die('disattivazione recovery all avvio fallita: ' + str(ex))


def cancel_unit(tx):
    unit = 'iptm-ipv6-revert-' + tx['token'] + '.timer'
    try:
        subprocess.run(['systemctl', 'stop', unit], timeout=5, capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        pass  # Pending check and token make a late timer harmless.


def status():
    flags = read_flags() if PROC.exists() else None
    st = current_state(flags)
    tx = pending_read()
    print('state=' + st)
    print('boot_disabled=' + ('1' if is_boot_disabled() else '0'))
    print('all=' + (str(flags.get('all', '?')) if flags is not None else '?'))
    print('default=' + (str(flags.get('default', '?')) if flags is not None else '?'))
    if flags is not None:
        print('interfaces=' + ','.join(f'{k}:{v}' for k, v in sorted(flags.items()) if k not in ('all','default'))[:1800])
    print('pending=' + ('1' if tx is not None else '0'))
    if tx is not None:
        print('pending_mode=' + tx.get('mode', '?'))
        print('seconds_left=' + str(max(0, 120 - int(time.time() - tx.get('started', 0)))))
    print('persistent=' + ('1' if PERSIST.exists() else '0'))


def apply(mode, ip):
    if mode not in ('enable', 'disable'):
        die('operazione non consentita')
    check_ipv4_session(ip)
    ensure_root_state()
    check_other_firewall_pending()
    if pending_read() is not None:
        die('esiste già una modifica IPv6 in attesa di conferma')
    flags = read_flags()
    if flags is None:
        die('IPv6 non esposto in /proc: la gestione runtime non è disponibile')
    before = current_state(flags)
    if before not in ('enabled', 'disabled', 'partial'):
        die('stato IPv6 incerto: operazione annullata')
    if mode == 'enable':
        preflight_enable()
    else:
        # Refuse an IPv4-only MAC policy unless disabled state is verified post-apply.
        pass
    if not HELPER.is_file() or HELPER.is_symlink() or not HELPER.is_absolute() or HELPER.stat().st_uid != 0:
        die('percorso helper non sicuro per il watchdog')
    if not shutil_which('systemd-run') or not shutil_which('systemctl'):
        die('systemd-run/systemctl assenti: rollback automatico non garantito')
    old_persistent = existing_persistent()
    token = secrets.token_hex(12)
    tx = dict(token=token, mode=mode, started=int(time.time()), flags=flags,
              persistent_before=old_persistent)
    save_pending(tx)
    try:
        install_boot_recovery()
    except (Exception, SystemExit):
        PENDING.unlink(missing_ok=True)
        try:
            remove_boot_recovery()
        except (Exception, SystemExit):
            pass  # Nessun flag modificato: unità residua non può ripristinare nulla.
        raise
    cmd = ['systemd-run', '--quiet', '--unit=iptm-ipv6-revert-' + token,
           '--on-active=120s', str(HELPER), 'ipv6-control', 'rollback', token]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=12)
    except (OSError, subprocess.TimeoutExpired) as ex:
        PENDING.unlink(missing_ok=True)
        remove_boot_recovery()
        die('watchdog non avviato, nessun flag modificato: ' + str(ex))
    if r.returncode != 0:
        PENDING.unlink(missing_ok=True)
        remove_boot_recovery()
        die('watchdog systemd non avviato, nessun flag modificato: ' + (r.stderr or r.stdout).strip()[:200])
    try:
        set_runtime(mode)
        persistent_write(mode)
    except (Exception, SystemExit) as ex:
        try:
            restore_original(tx)
        except (Exception, SystemExit) as rex:
            die('ERRORE CRITICO: cambio IPv6 incompleto e ripristino fallito; watchdog ancora attivo: ' + str(rex))
        remove_boot_recovery()
        PENDING.unlink(missing_ok=True)
        cancel_unit(tx)
        die('operazione IPv6 annullata e stato precedente ripristinato: ' + str(ex))
    print('pending=1')
    print('mode=' + mode)
    print('seconds_left=120')
    print('message=Flag kernel IPv6 aggiornati, inclusi all/default e tutte le interfacce; conferma da IPv4 entro 120 secondi')


def confirm(ip):
    check_ipv4_session(ip)
    tx = pending_read()
    if tx is None:
        die('nessuna modifica IPv6 da confermare')
    if time.time() - tx['started'] >= 120:
        die('tempo conferma scaduto: lascia eseguire il rollback automatico')
    flags = read_flags()
    expected = 'disabled' if tx['mode'] == 'disable' else 'enabled'
    if current_state(flags) != expected:
        die('stato runtime IPv6 non conforme, non confermato; rollback automatico ancora attivo')
    if not PERSIST.exists() or PERSIST.is_symlink():
        die('configurazione persistente assente: conferma rifiutata')
    desired = 1 if tx['mode'] == 'disable' else 0
    if f'net.ipv6.conf.default.disable_ipv6 = {desired}' not in PERSIST.read_text():
        die('flag delle interfacce future non persistito: conferma rifiutata')
    remove_boot_recovery()
    PENDING.unlink()
    cancel_unit(tx)
    print('confirmed=' + tx['mode'])


def rollback(token):
    tx = pending_read()
    if tx is None:
        print('noop=no-pending')
        return
    if token and token != tx['token']:
        print('noop=stale-transaction')
        return
    restore_original(tx)
    remove_boot_recovery()
    PENDING.unlink()
    if not token:
        cancel_unit(tx)
    print('rolled_back=' + tx['mode'])


def shutil_which(name):
    import shutil
    return shutil.which(name)


if not ARG:
    die('azione mancante', 2)
action = ARG[0]
if action == 'status':
    status()
else:
    ensure_root_state()
    lock = os.open(str(STATE / '.lock'), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock, 'rb') as lfd:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        if action == 'apply' and len(ARG) == 3:
            apply(ARG[1], ARG[2])
        elif action == 'confirm' and len(ARG) == 2:
            confirm(ARG[1])
        elif action == 'rollback' and len(ARG) in (1, 2):
            rollback(ARG[1] if len(ARG) == 2 else '')
        else:
            die('argomenti non validi', 2)
IPTM_IPV6_CONTROL_PY
}

# RC8: status/IPv6 emergency rollback are independent of configuration parsing.
# A broken /etc/iptables-manager.conf must never prevent the watchdog from undoing
# a kernel change or hide the current SQM job state.
WEBCONF=/etc/iptables-manager.web.json
iptm_sqm_status_early() {
  local d f state pid started now
  d=$(grep -m1 -oP '"DATA_DIR"\s*:\s*"\K/[A-Za-z0-9._/-]+' "$WEBCONF" 2>/dev/null)
  d="${d:-/var/lib/iptables-manager}"
  case "/$d/" in */../*|*/./*) echo 'Percorso dati SQM non valido' >&2; return 2;; esac
  f="$d/sqm-manual-job.status"
  [ -f "$f" ] && [ ! -L "$f" ] || { echo 'state=idle'; return 0; }
  state=$(sed -n 's/^state=//p' "$f" | head -1)
  case "$state" in
    running)
      pid=$(sed -n 's/^pid=//p' "$f" | head -1)
      started=$(sed -n 's/^started=//p' "$f" | head -1)
      now=$(date +%s)
      if ! [[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] ||
         [ $((now - ${started:-0})) -ge 360 ] || ! kill -0 "$pid" 2>/dev/null; then
        echo 'state=failed'; echo 'mode=error'; echo 'message=Job SQM interrotto o scaduto: i limiti non sono stati modificati'; return 0
      fi ;;
    success|failed|idle) ;;
    *) echo 'Stato SQM non valido o incompleto' >&2; return 1 ;;
  esac
  grep -E '^(state|mode|exit|finished|started|message)=' "$f" | head -n 8
}
if [[ "${1:-}" == ipv6-control ]]; then
