import re, shlex, sys
allowed = {'POST_SERVICES','POST_SCRIPT','SQM_IF','SQM_UP','SQM_DOWN',
 'SURICATA_YAML','BACKEND_WANTED','SQM_DIFFSERV','SQM_ACK','SQM_NAT',
 'SQM_OVERHEAD','SQM_WASH','SQM_AUTOCAL','SQM_INTERVAL_MIN'}
assignment = re.compile(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$')
try:
    with open(sys.argv[1], encoding='utf-8') as fp:
        for lineno, line in enumerate(fp,1):
            if not line.strip() or line.lstrip().startswith('#'): continue
            match=assignment.fullmatch(line.rstrip('\n'))
            if not match:
                raise ValueError(f'linea {lineno}: non è una semplice assegnazione')
            key, expression=match.groups()
            if key not in allowed:
                continue
            try:
                parts=shlex.split(expression, posix=True)
            except ValueError:
                raise ValueError(f'linea {lineno}: virgolette non bilanciate')
            if len(parts) != 1:
                raise ValueError(f'linea {lineno}: valore ambiguo')
            val=parts[0]
            if len(val)>2048 or any(ord(c)<32 for c in val) or any(c in val for c in '`$;|&<>'):
