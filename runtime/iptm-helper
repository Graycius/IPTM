  [ -e "$file" ] || return 0
  [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] || { echo 'IPTM: configurazione non regolare' >&2; return 1; }
  owner=$(stat -c '%u' "$file") || return 1
