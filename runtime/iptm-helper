  if [ -n "$SU_UPD" ]; then
    if "$SU_UPD" --help 2>&1 | grep -q -- '--suricata-conf'; then
      [ -n "$SU_YAML" ] && SU_UPD_ARGS+=(--suricata-conf "$SU_YAML")
    fi
    if "$SU_UPD" --help 2>&1 | grep -q -- '--suricata[^-]'; then
