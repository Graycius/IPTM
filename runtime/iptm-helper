    echo 'IPTM update: stato IPv6 del backup non disponibile' >&2; return 1;
  }
  [[ "$saved_v6_state" == enabled || "$saved_v6_state" == disabled ]] || {
    echo 'IPTM update: stato IPv6 del backup non valido' >&2; return 1;
  }
  v6_state=$(fw_ipv6_state) || {
    echo 'IPTM update: lettura dello stato IPv6 non affidabile; nessuna modifica alle regole' >&2
    return 1
  }
  [ "$v6_state" = "$saved_v6_state" ] || {
    echo "IPTM update: stato IPv6 cambiato durante l’aggiornamento ($saved_v6_state → $v6_state); non ripristino regole alla cieca" >&2
    return 1
  }
  live4=$(iptables-save 2>/dev/null) || {
    echo 'IPTM update: lettura firewall IPv4 fallita' >&2; return 1;
  }
  if ! printf '%s\n' "$live4" | grep -qxF '*filter' ||
     ! printf '%s\n' "$live4" | grep -qxF 'COMMIT'; then
    echo 'IPTM update: snapshot IPv4 post-update incompleto' >&2
    return 1
  fi
  live6=''
  if [ "$v6_state" = enabled ]; then
    [ -s "$1/live.v6" ] || {
      echo 'IPTM update: snapshot IPv6 precedente assente, firewall IPv6 attivo' >&2
      return 1
    }
    live6=$(ip6tables-save 2>/dev/null) || {
      echo 'IPTM update: lettura firewall IPv6 post-update fallita' >&2; return 1;
    }
    if ! printf '%s\n' "$live6" | grep -qxF '*filter' ||
       ! printf '%s\n' "$live6" | grep -qxF 'COMMIT'; then
      echo 'IPTM update: snapshot IPv6 post-update incompleto' >&2
      return 1
    fi
  fi
  n1=$(printf '%s\n' "$live4" "$live6" | grep -c '^-A ') || true
  p1=$(printf '%s\n' "$live4" | awk '/^\*/{f=($0=="*filter")} f && /^:INPUT /{print $2; exit}')
  [[ "$p1" =~ ^(ACCEPT|DROP|REJECT)$ ]] || {
    echo 'IPTM update: policy INPUT post-update sconosciuta' >&2; return 1;
  }
  if [ "$n0" -gt 3 ] && {
       [ "$n1" -lt $((n0 / 2)) ] ||
       { [ "$p0" = DROP ] && [ "$p1" != DROP ]; };
     }; then
    echo "IPTM update: regole firewall ridotte o policy INPUT modificata ($n0 → $n1; $p0 → $p1), avvio recupero" >&2
    if [ -s "$1/live.ipset" ] && command -v ipset >/dev/null; then
      ipset restore -exist < "$1/live.ipset" 2>/dev/null || {
        echo 'IPTM update: ripristino ipset fallito' >&2; rc=1;
      }
    fi
    iptables-restore < "$1/live.v4" 2>/dev/null || {
      echo 'IPTM update: ripristino IPv4 fallito' >&2; rc=1;
    }
    if [ "$v6_state" = enabled ]; then
      ip6tables-restore < "$1/live.v6" 2>/dev/null || {
        echo 'IPTM update: ripristino IPv6 fallito' >&2; rc=1;
      }
    fi
    [ "$rc" -eq 0 ] && echo 'IPTM update: firewall precedente ripristinato; aggiornamento annullato' >&2
    return 1
  fi
